 "time", "start": 107.64, "end": 108.0}]}, {"id": 37, "startTime": 108.04, "endTime": 110.2, "fullText": "and the rest of the galaxy was reduced to", "words": [{"text": "and", "start": 108.04, "end": 108.38}, {"text": "the", "start": 108.38, "end": 108.5}, {"text": "rest", "start": 108.5, "end": 108.66}, {"text": "of", "start": 108.66, "end": 108.82}, {"text": "the", "start": 108.82, "end": 108.92}, {"text": "galaxy", "start": 108.92, "end": 109.34}, {"text": "was", "start": 109.34, "end": 109.68}, {"text": "reduced", "start": 109.68, "end": 109.96}, {"text": "to", "start": 109.96, "end": 110.2}]}, {"id": 38, "startTime": 110.2, "endTime": 113.22, "fullText": "abject poverty. And so the system broke down,", "words": [{"text": "abject", "start": 110.2, "end": 110.6}, {"text": "poverty.", "start": 110.6, "end": 110.98}, {"text": "And", "start": 111.64, "end": 111.66}, {"text": "so", "start": 111.66, "end": 111.82}, {"text": "the", "start": 111.82, "end": 111.96}, {"text": "system", "start": 111.96, "end": 112.26}, {"text": "broke", "start": 112.26, "end": 112.52}, {"text": "down,", "start": 112.52, "end": 113.22}]}, {"id": 39, "startTime": 113.22, "endTime": 116.36, "fullText": "the empire collapsed, and a long sullen silence settled", "words": [{"text": "the", "start": 113.22, "end": 113.3}, {"text": "empire", "start": 113.3, "end": 113.68}, {"text": "collapsed,", "start": 113.68, "end": 114.5}, {"text": "and", "start": 114.5, "end": 114.86}, {"text": "a", "start": 114.86, "end": 115.02}, {"text": "long", "start": 115.02, "end": 115.24}, {"text": "sullen", "start": 115.24, "end": 115.6}, {"text": "silence", "start": 115.6, "end": 116.02}, {"text": "settled", "start": 116.02, "end": 116.36}]}, {"id": 40, "startTime": 116.36, "endTime": 119.82, "fullText": "over a billion worlds, disturbed only by the pin-scratchings", "words": [{"text": "over", "start": 116.36, "end": 116.66}, {"text": "a", "start": 116.66, "end": 116.84}, {"text": "billion", "start": 116.84, "end": 117.08}, {"text": "worlds,", "start": 117.08, "end": 117.9}, {"text": "disturbed", "start": 117.9, "end": 118.28}, {"text": "only", "start": 118.28, "end": 118.72}, {"text": "by", "start": 118.72, "end": 118.94}, {"text": "the", "start": 118.94, "end": 119.12}, {"text": "pin-scratchings", "start": 119.12, "end": 119.82}]}, {"id": 41, "startTime": 119.82, "endTime": 122.1, "fullText": "of scholars as they labored into the night over", "words": [{"text": "of", "start": 119.82, "end": 120.0}, {"text": "scholars", "start": 120.0, "end": 120.42}, {"text": "as", "start": 120.42, "end": 120.76}, {"text": "they", "start": 120.76, "end": 120.9}, {"text": "labored", "start": 120.9, "end": 121.24}, {"text": "into", "start": 121.24, "end": 121.48}, {"text": "the", "start": 121.48, "end": 121.64}, {"text": "night", "start": 121.64, "end": 121.84}, {"text": "over", "start": 121.84, "end": 122.1}]}, {"id": 42, "startTime": 122.1, "endTime": 124.44, "fullText": "smug little treaties on the value of a planned", "words": [{"text": "smug", "start": 122.1, "end": 122.58}, {"text": "little", "start": 122.58, "end": 122.84}, {"text": "treaties", "start": 122.84, "end": 123.2}, {"text": "on", "start": 123.2, "end": 123.42}, {"text": "the", "start": 123.42, "end": 123.52}, {"text": "value", "start": 123.52, "end": 123.86}, {"text": "of", "start": 123.86, "end": 124.04}, {"text": "a", "start": 124.04, "end": 124.14}, {"text": "planned", "start": 124.14, "end": 124.44}]}, {"id": 43, "startTime": 124.44, "endTime": 128.34, "fullText": "political economy. Magrathia itself disappeared and its memory", "words": [{"text": "political", "start": 124.44, "end": 124.84}, {"text": "economy.", "start": 124.84, "end": 125.66}, {"text": "Magrathia", "start": 125.98, "end": 126.44}, {"text": "itself", "start": 126.44, "end": 126.82}, {"text": "disappeared", "start": 126.82, "end": 127.36}, {"text": "and", "start": 127.36, "end": 127.8}, {"text": "its", "start": 127.8, "end": 127.96}, {"text": "memory", "start": 127.96, "end": 128.34}]}, {"id": 44, "startTime": 128.34, "endTime": 130.78, "fullText": "soon passed into the obscurity of legend.", "words": [{"text": "soon", "start": 128.34, "end": 128.74}, {"text": "passed", "start": 128.74, "end": 129.12}, {"text": "into", "start": 129.12, "end": 129.36}, {"text": "the", "start": 129.36, "end": 129.54}, {"text": "obscurity", "start": 129.54, "end": 130.04}, {"text": "of", "start": 130.04, "end": 130.28}, {"text": "legend.", "start": 130.28, "end": 130.78}]}, {"id": 45, "startTime": 131.16, "endTime": 133.54, "fullText": "In these enlightened days, of course, no one believes", "words": [{"text": "In", "start": 131.16, "end": 131.3}, {"text": "these", "start": 131.3, "end": 131.46}, {"text": "enlightened", "start": 131.46, "end": 131.84}, {"text": "days,", "start": 131.84, "end": 132.3}, {"text": "of", "start": 132.3, "end": 132.34}, {"text": "course,", "start": 132.34, "end": 132.84}, {"text": "no", "start": 132.84, "end": 133.1}, {"text": "one", "start": 133.1, "end": 133.24}, {"text": "believes", "start": 133.24, "end": 133.54}]}, {"id": 46, "startTime": 133.54, "endTime": 134.22, "fullText": "a word of it.", "words": [{"text": "a", "start": 133.54, "end": 133.74}, {"text": "word", "start": 133.74, "end": 133.9}, {"text": "of", "start": 133.9, "end": 134.06}, {"text": "it.", "start": 134.06, "end": 134.22}]}], "primaryColor": "#111111", "mutedColor": "#c8c8c8", "backgroundColor": "#faf9f6", "fontFamily": "Playfair Display, Georgia, Garamond, serif", "mode": "cumulative"}