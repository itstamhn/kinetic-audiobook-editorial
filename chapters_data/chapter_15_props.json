net", "start": 85.3, "end": 85.62}, {"text": "Magrathia,", "start": 85.62, "end": 86.58}]}, {"id": 30, "startTime": 86.62, "endTime": 89.5, "fullText": "where hyperspatial engineers sucked matter through white holes in", "words": [{"text": "where", "start": 86.62, "end": 86.74}, {"text": "hyperspatial", "start": 86.74, "end": 87.54}, {"text": "engineers", "start": 87.54, "end": 87.84}, {"text": "sucked", "start": 87.84, "end": 88.18}, {"text": "matter", "start": 88.18, "end": 88.48}, {"text": "through", "start": 88.48, "end": 88.76}, {"text": "white", "start": 88.76, "end": 89.1}, {"text": "holes", "start": 89.1, "end": 89.3}, {"text": "in", "start": 89.3, "end": 89.5}]}, {"id": 31, "startTime": 89.5, "endTime": 91.56, "fullText": "space to form it into dream planets,", "words": [{"text": "space", "start": 89.5, "end": 89.74}, {"text": "to", "start": 89.74, "end": 90.02}, {"text": "form", "start": 90.02, "end": 90.34}, {"text": "it", "start": 90.34, "end": 90.42}, {"text": "into", "start": 90.42, "end": 90.62}, {"text": "dream", "start": 90.62, "end": 90.88}, {"text": "planets,", "start": 90.88, "end": 91.56}]}, {"id": 32, "startTime": 91.84, "endTime": 95.56, "fullText": "gold planets, platinum planets, soft rubber planets with lots", "words": [{"text": "gold", "start": 91.84, "end": 92.1}, {"text": "planets,", "start": 92.1, "end": 92.92}, {"text": "platinum", "start": 92.92, "end": 93.16}, {"text": "planets,", "start": 93.16, "end": 94.06}, {"text": "soft", "start": 94.06, "end": 94.38}, {"text": "rubber", "start": 94.38, "end": 94.62}, {"text": "planets", "start": 94.62, "end": 95.02}, {"text": "with", "start": 95.02, "end": 95.26}, {"text": "lots", "start": 95.26, "end": 95.56}]}, {"id": 33, "startTime": 95.56, "endTime": 98.8, "fullText": "of earthquakes. All lovingly made to meet the exacting", "words": [{"text": "of", "start": 95.56, "end": 95.72}, {"text": "earthquakes.", "start": 95.72, "end": 96.06}, {"text": "All", "start": 96.98, "end": 97.18}, {"text":