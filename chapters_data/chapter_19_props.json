, "end": 185.468}, {"text": "can", "start": 185.468, "end": 185.628}, {"text": "see", "start": 185.628, "end": 185.788}, {"text": "this", "start": 185.788, "end": 185.968}, {"text": "relationship", "start": 185.968, "end": 186.448}, {"text": "is", "start": 186.448, "end": 186.848}, {"text": "something", "start": 186.848, "end": 187.068}, {"text": "we're", "start": 187.068, "end": 187.328}]}, {"id": 72, "startTime": 187.328, "endTime": 188.808, "fullText": "all going to have to work at.", "words": [{"text": "all", "start": 187.328, "end": 187.508}, {"text": "going", "start": 187.508, "end": 187.748}, {"text": "to", "start": 187.748, "end": 187.928}, {"text": "have", "start": 187.928, "end": 188.088}, {"text": "to", "start": 188.088, "end": 188.248}, {"text": "work", "start": 188.248, "end": 188.508}, {"text": "at.", "start": 188.508, "end": 188.808}]}, {"id": 73, "startTime": 189.088, "endTime": 190.048, "fullText": "And the hatchway opened.", "words": [{"text": "And", "start": 189.088, "end": 189.248}, {"text": "the", "start": 189.248, "end": 189.328}, {"text": "hatchway", "start": 189.328, "end": 189.708}, {"text": "opened.", "start": 189.708, "end": 190.048}]}, {"id": 74, "startTime": 190.608, "endTime": 192.108, "fullText": "An icy wind ripped into them.", "words": [{"text": "An", "start": 190.608, "end": 190.768}, {"text": "icy", "start": 190.768, "end": 191.008}, {"text": "wind", "start": 191.008, "end": 191.308}, {"text": "ripped", "start": 191.308, "end": 191.528}, {"text": "into", "start": 191.528, "end": 191.788}, {"text": "them.", "start": 191.788, "end": 192.108}]}, {"id": 75, "startTime": 192.268, "endTime": 194.768, "fullText": "They hugged themselves warmly and stepped down the ramp", "words": [{"text": "They", "start": 192.268, "end": 192.408}, {"text": "hugged", "start": 192.408, "end": 192.668}, {"text": "themselves", "start": 192.668, "end": 192.988}, {"text": "warmly", "start": 192.988, "end": 193.608}, {"text": "and", "start": 193.608, "end": 193.848}, {"text": "stepped", "start": 193.848, "end": 194.108}, {"text": "down", "start": 194.108, "end": 194.328}, {"text": "the", "start": 194.328, "end": 194.488}, {"text": "ramp", "start": 194.488, "end": 194.768}]}, {"id": 76, "startTime": 194.768, "endTime": 196.668, "fullText": "onto the barren dust of Magrathia.", "words": [{"text": "onto", "start": 194.768, "end": 195.008}, {"text": "the", "start": 195.008, "end": 195.208}, {"text": "barren", "start": 195.208, "end": 195.528}, {"text": "dust", "start": 195.528, "end": 195.728}, {"text": "of", "start": 195.728, "end": 195.908}, {"text": "Magrathia.", "start": 195.908, "end": 196.668}]}, {"id": 77, "startTime": 196.988, "endTime": 197.868, "fullText": "It'll all end in tears.", "words": [{"text": "It'll", "start": 196.988, "end": 197.248}, {"text": "all", "start": 197.248, "end": 197.428}, {"text": "end", "start": 197.428, "end": 197.488}, {"text": "in", "start": 197.488, "end": 197.648}, {"text": "tears.", "start": 197.648, "end": 197.868}]}, {"id": 78, "startTime": 198.268, "endTime": 200.708, "fullText": "I know it. shouted Eddie after them and closed", "words": [{"text": "I", "start": 198.268, "end": 198.408}, {"text": "know", "start": 198.408, "end": 198.548}, {"text": "it.", "start": 198.548, "end": 198.788}, {"text": "shouted", "start": 199.128, "end": 199.368}, {"text": "Eddie", "start": 199.368, "end": 199.568}, {"text": "after", "start": 199.568, "end": 199.908}, {"text": "them", "start": 199.908, "end": 200.108}, {"text": "and", "start": 200.108, "end": 200.408}, {"text": "closed", "start": 200.408, "end": 200.708}]}, {"id": 79, "startTime": 200.708, "endTime": 203.448, "fullText": "the hatchway again. A few minutes later he opened", "words": [{"text": "the", "start": 200.708, "end": 200.888}, {"text": "hatchway", "start": 200.888, "end": 201.268}, {"text": "again.", "start": 201.268, "end": 201.788}, {"text": "A", "start": 202.108, "end": 202.268}, {"text": "few", "start": 202.268, "end": 202.408}, 