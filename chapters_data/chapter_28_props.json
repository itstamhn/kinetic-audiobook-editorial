, "end": 8.66}, {"text": "going", "start": 8.66, "end": 8.86}, {"text": "to", "start": 8.86, "end": 9}, {"text": "get", "start": 9, "end": 9.14}, {"text": "lynched", "start": 9.14, "end": 9.38}, {"text": "aren't", "start": 9.38, "end": 9.6}, {"text": "we", "start": 9.6, "end": 9.78}]}, {"id": 4, "startTime": 9.78, "endTime": 12.96, "fullText": "he whispered it was a tough assignment said deep", "words": [{"text": "he", "start": 9.78, "end": 10.3}, {"text": "whispered", "start": 10.3, "end": 10.74}, {"text": "it", "start": 10.74, "end": 11.28}, {"text": "was", "start": 11.28, "end": 11.4}, {"text": "a", "start": 11.4, "end": 11.52}, {"text": "tough", "start": 11.52, "end": 11.64}, {"text": "assignment", "start": 11.64, "end": 12.02}, {"text": "said", "start": 12.02, "end": 12.74}, {"text": "deep", "start": 12.74, "end": 12.96}]}, {"id": 5, "startTime": 13, "endTime": 15.96, "fullText": "thought mildly. 42. Yelled Loonqual.", "words": [{"text": "thought", "start": 13, "end": 13.18}, {"text": "mildly.", "start": 13.18, "end": 14.22}, {"text": "42.", "start": 14.22, "end": 15.26}, {"text": "Yelled", "start": 15.26, "end": 15.34}, {"text": "Loonqual.", "start": 15.34, "end": 15.96}]}, {"id": 6, "startTime": 15.96, "endTime": 17.78, "fullText": "Is that all you've got to show for?", "words": [{"text": "Is", "start": 15.96, "end": 16.38}, {"text": "that", "start": 16.38, "end": 16.52}, {"text": "all", "start": 16.52, "end": 16.64}, {"text": "you've", "start": 16.64, "end": 16.84}, {"text": "got", "start": 16.84, "end": 16.92}, {"text": "to", "start": 16.92, "end": 17.04}, {"text": "show", "start": 17.04, "end": 17.24}, {"text": "for?", "start": 17.24, "end": 17.78}]}, {"id": 7, "startTime": 17.78, "endTime": 19.82, "fullText": "Seven and a half million years work?", "words": [{"text": "Seven", "start": 17.78, "end": 18.34}, {"text": "and", "start": 18.34, "end": 18.54}, {"text": "a", "start": 18.54, "end": 18.66}, {"text": "half", "start": 18.66, "end": 18.82}, {"text": "million", "start": 18.82, "end": 19.06}, {"text": "years", "start": 18.64, "end": 19.4}, {"text": "work?", "start": 19.4, "end": 19.82}]}, {"id": 8, "startTime": 19.82, "endTime": 22.68, "fullText": "I checked it very thoroughly, said the computer,", "words": [{"text": "I", "start": 19.82, "end": 20.3}, {"text": "checked", "start": 20.3, "end": 20.52}, {"text": "it", "start": 20.52, "end": 20.7}, {"text": "very", "start": 20.7, "end": 20.94}, {"text": "thoroughly,", "start": 20.94, "end": 21.56}, {"text": "said", "start": 21.56, "end": 21.96}, {"text": "the", "start": 21.96, "end": 22.08}, {"text": "computer,", "start": 22.08, "end": 22.68}]}, {"id": 9, "startTime": 22.68, "endTime": 24.54, "fullText": "and that quite definitely is the answer.", "words": [{"text": "and", "start": 22.68, "end": 22.96}, {"text": "that", "start": 22.96, "end": 23.08}, {"text": "quite", "start": 23.08, "end": 23.36}, {"text": "definitely", "start": 23.36, "end": 23.84}, {"text": "is", "start": 23.84, "end": 24.14}, {"text": "the", "start": 24.14, "end": 24.26}, {"text": "answer.", "start": 24.26, "end": 24.54}]}, {"id": 10, "startTime": 25.1, "endTime": 27.12, "fullText": "I think the problem, to be quite honest with", "words": [{"text": "I", "start": 25.1, "end": 25.28}, {"text": "think", "start": 25.28, "end": 25.44}, {"text": "the", "start": 25.44, "end": 25.58}, {"text": "problem,", "start": 25.58, "end": 26.08}, {"text": "to", "start": 26.08, "end": 26.2}, {"text": "be", "start": 26.2, "end": 26.3}, {"text": "quite", "start": 26.3, "end": 26.6}, {"text": "honest", "start": 26.6, "end": 26.88}, {"text": "with", "start": 26.88, "end": 27.12}]}, {"id": 11, "startTime": 27.12, "endTime": 29.32, "fullText": "you, is that you've never actually known what the", "words": [{"text": "you,", "start": 27.12, "end": 27.44}, {"text": "is", "start": 27.44, "end": 27.66}, {"text": "that", "start": 27.66, "end": 27.78}, {"text": "you've", "start": 27.78, "end": 27.92}, {"text": "never", "start": 27.92, "end": 28.22}, {"text": "actually", "start": 28.22, "end": 28.64}, {"text": "known", "start": 28.64, "end": 28.98}, {"text": "what", "start": 28.98, "end": 29.2}, {"text": "the", "start": 29.2, "end": 29.32}]}, {"id": 12, "startTime": 28.86, "endTime": 31.72, "fullText": "question is. But it was the great question.", "words": [{"text": "question", "start": 28.86, "end": 29.64}, {"text": "is.", "start": 29.64, "end": 30.1}, {"text": "But", "start": 30.1, "end": 30.58}, {"text": "it", "start": 30.58, "end": 30.66}, {"text": "was", "start": 30.66, "end": 30.78}, {"text": "the", "start": 30.78, "end": 30.92}, {"text": "great", "start": 30.92, "end": 31.08}, {"text": "question.", "start": 31.08, "end": 31.72}]}, {"id": 13, "startTime": 31.72, "endTime": 34.38, "fullText": "The ultimate question of life, the universe,", "words": [{"text": "The", "start": 31.72, "end": 32.14}, {"text": "ultimate", "start": 32.14, "end": 32.38}, {"text": "question", "start": 32.38, "end": 32.8}, {"text": "of", "start": 32.8, "end": 33}, {"text": "life,", "start": 33, "end": 33.6}, {"text": "the", "start": 33.6, "end": 33.72}, {"text": "universe,", "start": 33.72, "end": 34.38}]}, {"id": 14, "startTime": 34.34, "endTime": 36.46, "fullText": "and everything. Howled Loonqual.", "words": [{"text": "and", "start": 34.34, "end": 34.48}, {"text": "everything.", "start": 34.48, "end": 35.36}, {"text": "Howled", "start": 35.36, "end": 35.68}, {"text": "Loonqual.", "start": 35.68, "end": 36.46}]}, {"id": 15, "startTime": 36.46, "endTime": 38.72, "fullText": "Yes, said deep thought with the air of one", "words": [{"text": "Yes,", "start": 36.46, "end": 37.34}, {"text": "said", "start": 37.34, "end": 37.62}, {"text": "deep", "start": 37.62, "end": 37.82}, {"text": "thought", "start": 37.82, "end": 38.02}, {"text": "with", "start": 38.02, "end": 38.18}, {"text": "the", "start": 38.18, "end": 38.3}, {"text": "air", "start": 38.3, "end": 38.42}, {"text": "of", "start": 38.42, "end": 38.58}, {"text": "one", "start": 38.58, "end": 38.72}]}, {"id": 16, "startTime": 38.72, "endTime": 40.52, "fullText": "who suffers fools gladly.", "words": [{"text": "who", "start": 38.72, "end": 38.84}, {"text": "suffers", "start": 38.84, "end": 39.18}, {"text": "fools", "start": 39.18, "end": 39.5}, {"text": "gladly.", "start": 39.54, "end": 40.52}]}, {"id": 17, "startTime": 40.52, "endTime": 41.58, "fullText": "But what actually is it?", "words": [{"text": "But", "start": 40.52, "end": 40.62}, {"text": "what", "start": 40.62, "end": 40.74}, {"text": "actually", "start": 40.74, "end": 41.1}, {"text": "is", "start": 41.1, "end": 41.36}, {"text": "it?", "start": 41.36, "end": 41.58}]}, {"id": 18, "startTime": 41.58, "endTime": 44.58, "fullText": "A slow, stupefied silence crept over the men as", "words": [{"text": "A", "start": 41.58, "end": 42.06}, {"text": "slow,", "start": 42.06, "end": 42.44}, {"text": "stupefied", "start": 42.44, "end": 42.98}, {"text": "silence", "start": 42.98, "end": 43.44}, {"text": "crept", "start": 43.44, "end": 43.78}, {"text": "over", "start": 43.78, "end": 44.02}, {"text": "the", "start": 44.02, "end": 44.18}, {"text": "men", "start": 44.18, "end": 44.38}, {"text": "as", "start": 44.38, "end": 44.58}]}, {"id": 19, "startTime": 44.58, "endTime": 46.5, "fullText": "they stared at the computer and then at each", "words": [{"text": "they", "start": 44.58, "end": 44.7}, {"text": "stared", "start": 44.7, "end": 45}, {"text": "at", "start": 45, "end": 45.18}, {"text": "the", "start": 45.18, "end": 45.3}, {"text": "computer", "start": 44.82, "end": 45.68}, {"text": "and", "start": 45.68, "end": 46.08}, {"text": "then", "start": 46.08, "end": 46.2}, {"text": "at", "start": 46.2, "end": 46.34}, {"text": "each", "start": 46.34, "end": 46.5}]}, {"id": 20, "startTime": 46.5, "endTime": 49, "fullText": "other. Well, you know, it's just everything.", "words": [{"text": "other.", "start": 46.5, "end": 46.82}, {"text": "Well,", "start": 46.82, "end": 47.56}, {"text": "you", "start": 47.56, "end": 47.82}, {"text": "know,", "start": 47.82, "end": 48.16}, {"text": "it's", "start": 48.16, "end": 48.46}, {"text": "just", "start": 48.46, "end": 48.58}, {"text": "everything.", "start": 48.58, "end": 49}]}, {"id": 21, "startTime": 49, "endTime": 53.2, "fullText": "Everything. Offered. Fouchk weakly.", "words": [{"text": "Everything.", "start": 49, "end": 50.26}, {"text": "Offered.", "start": 50.26, "end": 51.84}, {"text": "Fouchk", "start": 52.16, "end": 52.46}, {"text": "weakly.", "start": 52.46, "end": 53.2}]}, {"id": 22, "startTime": 53.2, "endTime": 55.56, "fullText": "Exactly. Said Deep Thought.", "words": [{"text": "Exactly.", "start": 53.2, "end": 53.7}, {"text": "Said", "start": 53.7, "end": 54.7}, {"text": "Deep", "start": 54.7, "end": 54.92}, {"text": "Thought.", "start": 54.92, "end": 55.56}]}, {"id": 23, "startTime": 55.56, "endTime": 57.56, "fullText": "So once you do know what the question actually", "words": [{"text": "So", "start": 55.56, "end": 55.9}, {"text": "once", "start": 55.9, "end": 56.08}, {"text": "you", "start": 56.08, "end": 56.22}, {"text": "do", "start": 56.22, "end": 56.34}, {"text": "know", "start": 56.34, "end": 56.56}, {"text": "what", "start": 56.56, "end": 56.74}, {"text": "the", "start": 56.74, "end": 56.84}, {"text": "question", "start": 56.84, "end": 57.16}, {"text": "actually", "start": 57.16, "end": 57.56}]}, {"id": 24, "startTime": 57.56, "endTime": 59.86, "fullText": "is, you'll know what the answer means.", "words": [{"text": "is,", "start": 57.56, "end": 58.2}, {"text": "you'll", "start": 58.24, "end": 58.44}, {"text": "know", "start": 58.44, "end": 58.6}, {"text": "what", "start": 58.6, "end": 58.72}, {"text": "the", "start": 58.72, "end": 58.82}, {"text": "answer", "start": 58.82, "end": 59.12}, {"text": "means.", "start": 59.12, "end": 59.86}]}, {"id": 25, "startTime": 59.86, "endTime": 62.9, "fullText": "Oh, terrific, muttered Fouchk flinging aside his notebook and", "words": [{"text": "Oh,", "start": 59.86, "end": 60.16}, {"text": "terrific,", "start": 60.16, "end": 60.78}, {"text": "muttered", "start": 60.78, "end": 61.06}, {"text": "Fouchk", "start": 61.06, "end": 61.48}, {"text": "flinging", "start": 61.48, "end": 61.74}, {"text": "aside", "start": 61.74, "end": 62.08}, {"text": "his", "start": 62.08, "end": 62.3}, {"text": "notebook", "start": 62.3, "end": 62.58}, {"text": "and", "start": 62.58, "end": 62.9}]}, {"id": 26, "startTime": 62.82, "endTime": 64.72, "fullText": "wiping away a tiny tear.", "words": [{"text": "wiping", "start": 62.82, "end": 63.24}, {"text": "away", "start": 63.24, "end": 63.5}, {"text": "a", "start": 63.5, "end": 63.7}, {"text": "tiny", "start": 63.7, "end": 63.96}, {"text": "tear.", "start": 63.96, "end": 64.72}]}, {"id": 27, "startTime": 64.72, "endTime": 66.84, "fullText": "Look. All right. All right.", "words": [{"text": "Look.", "start": 64.72, "end": 65.24}, {"text": "All", "start": 65.24, "end": 65.68}, {"text": "right.", "start": 65.68, "end": 66}, {"text": "All", "start": 66, "end": 66.38}, {"text": "right.", "start": 66.38, "end": 66.84}]}, {"id": 28, "startTime": 66.84, "endTime": 68.8, "fullText": "Said Lung Kwal. Can you just please tell us", "words": [{"text": "Said", "start": 66.84, "end": 67.02}, {"text": "Lung", "start": 67.02, "end": 67.24}, {"text": "Kwal.", "start": 67.24, "end": 67.68}, {"text": "Can", "start": 67.68, "end": 68.02}, {"text": "you", "start": 68.02, "end": 68.12}, {"text": "just", "start": 68.12, "end": 68.26}, {"text": "please", "start": 68.26, "end": 68.46}, {"text": "tell", "start": 68.46, "end": 68.68}, {"text": "us", "start": 68.72, "end": 68.8}]}, {"id": 29, "startTime": 68.8, "endTime": 70.86, "fullText": "the question? The ultimate question?", "words": [{"text": "the", "start": 68.8, "end": 68.94}, {"text": "question?", "start": 68.94, "end": 69.48}, {"text": "The", "start": 69.48, "end": 69.94}, {"text": "ultimate", "start": 69.94, "end": 70.2}, {"text": "question?", "start": 70.2, "end": 70.86}]}, {"id": 30, "startTime": 70.86, "endTime": 74.54, "fullText": "Yes. Of life, the universe, and everything?", "words": [{"text": "Yes.", "start": 70.86, "end": 71.72}, {"text": "Of", "start": 71.72, "end": 72.22}, {"text": "life,", "start": 72.22, "end": 72.78}, {"text": "the", "start": 72.78, "end": 73}, {"text": "universe,", "start": 73, "end": 73.66}, {"text": "and", "start": 73.66, "end": 73.96}, {"text": "everything?", "start": 73.96, "end": 74.54}]}, {"id": 31, "startTime": 74.54, "endTime": 77.4, "fullText": "Yes. Deep Thought pondered this for a moment.", "words": [{"text": "Yes.", "start": 74.54, "end": 75.36}, {"text": "Deep", "start": 75.74, "end": 75.92}, {"text": "Thought", "start": 75.92, "end": 76.08}, {"text": "pondered", "start": 76.08, "end": 76.46}, {"text": "this", "start": 76.46, "end": 76.66}, {"text": "for", "start": 76.66, "end": 76.8}, {"text": "a", "start": 76.8, "end": 76.92}, {"text": "moment.", "start": 76.92, "end": 77.4}]}, {"id": 32, "startTime": 77.4, "endTime": 79.66, "fullText": "Tricky, he said. But can you do it?", "words": [{"text": "Tricky,", "start": 77.4, "end": 78}, {"text": "he", "start": 78, "end": 78.1}, {"text": "said.", "start": 78.1, "end": 78.58}, {"text": "But", "start": 78.58, "end": 79.04}, {"text": "can", "start": 79.04, "end": 79.14}, {"text": "you", "start": 79.14, "end": 79.26}, {"text": "do", "start": 79.26, "end": 79.42}, {"text": "it?", "start": 79.42, "end": 79.66}]}, {"id": 33, "startTime": 79.66, "endTime": 82.88, "fullText": "cried Loonqual. Deep Thought pondered this for another long", "words": [{"text": "cried", "start": 79.66, "end": 80.12}, {"text": "Loonqual.", "start": 80.12, "end": 80.84}, {"text": "Deep", "start": 81.2, "end": 81.36}, {"text": "Thought", "start": 81.36, "end": 81.56}, {"text": "pondered", "start": 81.56, "end": 81.9}, {"text": "this", "start": 81.9, "end": 82.12}, {"text": "for", "start": 82.12, "end": 82.24}, {"text": "another", "start": 82.24, "end": 82.56}, {"text": "long", "start": 82.56, "end": 82.88}]}, {"id": 34, "startTime": 82.88, "endTime": 85.9, "fullText": "moment. Finally. No, he said firmly.", "words": [{"text": "moment.", "start": 82.88, "end": 83.64}, {"text": "Finally.", "start": 83.64, "end": 84.46}, {"text": "No,", "start": 84.46, "end": 84.78}, {"text": "he", "start": 84.78, "end": 85.08}, {"text": "said", "start": 85.08, "end": 85.32}, {"text": "firmly.", "start": 85.32, "end": 85.9}]}, {"id": 35, "startTime": 85.9, "endTime": 88.78, "fullText": "Both men collapsed onto their chairs in despair.", "words": [{"text": "Both", "start": 85.9, "end": 86.44}, {"text": "men", "start": 86.44, "end": 86.68}, {"text": "collapsed", "start": 86.28, "end": 87.16}, {"text": "onto", "start": 87.16, "end": 87.42}, {"text": "their", "start": 87.42, "end": 87.58}, {"text": "chairs", "start": 87.58, "end": 87.92}, {"text": "in", "start": 87.92, "end": 88.1}, {"text": "despair.", "start": 88.1, "end": 88.78}]}, {"id": 36, "startTime": 88.78, "endTime": 91, "fullText": "But I'll tell you who can, said Deep Thought.", "words": [{"text": "But", "start": 88.78, "end": 89.18}, {"text": "I'll", "start": 89.18, "end": 89.32}, {"text": "tell", "start": 89.32, "end": 89.44}, {"text": "you", "start": 89.44, "end": 89.58}, {"text": "who", "start": 89.58, "end": 89.7}, {"text": "can,", "start": 89.7, "end": 90.2}, {"text": "said", "start": 90.2, "end": 90.38}, {"text": "Deep", "start": 90.38, "end": 90.58}, {"text": "Thought.", "start": 90.58, "end": 91}]}, {"id": 37, "startTime": 91.34, "endTime": 92.96, "fullText": "They both looked up sharply.", "words": [{"text": "They", "start": 91.34, "end": 91.52}, {"text": "both", "start": 91.52, "end": 91.76}, {"text": "looked", "start": 91.76, "end": 91.98}, {"text": "up", "start": 91.98, "end": 92.12}, {"text": "sharply.", "start": 92.12, "end": 92.96}]}, {"id": 38, "startTime": 92.96, "endTime": 96.28, "fullText": "Who? Tell us. Suddenly Arthur began to feel his", "words": [{"text": "Who?", "start": 92.96, "end": 93.52}, {"text": "Tell", "start": 93.52, "end": 93.88}, {"text": "us.", "start": 93.88, "end": 94.38}, {"text": "Suddenly", "start": 94.38, "end": 94.98}, {"text": "Arthur", "start": 94.98, "end": 95.3}, {"text": "began", "start": 95.3, "end": 95.68}, {"text": "to", "start": 95.68, "end": 95.9}, {"text": "feel", "start": 95.9, "end": 96.08}, {"text": "his", "start": 96.08, "end": 96.28}]}, {"id": 39, "startTime": 96.28, "endTime": 99.22, "fullText": "apparently non-existent scalp began to crawl as he found", "words": [{"text": "apparently", "start": 96.28, "end": 96.68}, {"text": "non-existent", "start": 96.86, "end": 97.5}, {"text": "scalp", "start": 97.5, "end": 97.82}, {"text": "began", "start": 97.82, "end": 98.12}, {"text": "to", "start": 98.12, "end": 98.3}, {"text": "crawl", "start": 98.3, "end": 98.56}, {"text": "as", "start": 98.56, "end": 98.82}, {"text": "he", "start": 98.82, "end": 98.92}, {"text": "found", "start": 98.92, "end": 99.22}]}, {"id": 40, "startTime": 99.22, "endTime": 103.4, "fullText": "himself moving slowly but inexorably forward towards the console,", "words": [{"text": "himself", "start": 99.22, "end": 99.6}, {"text": "moving", "start": 99.6, "end": 99.92}, {"text": "slowly", "start": 99.92, "end": 100.4}, {"text": "but", "start": 100.4, "end": 100.86}, {"text": "inexorably", "start": 100.86, "end": 101.38}, {"text": "forward", "start": 101.38, "end": 101.84}, {"text": "towards", "start": 101.38, "end": 102.32}, {"text": "the", "start": 102.32, "end": 102.48}, {"text": "console,", "start": 102.48, "end": 103.4}]}, {"id": 41, "startTime": 103.4, "endTime": 105, "fullText": "but it was only a dramatic zoom on the", "words": [{"text": "but", "start": 103.4, "end": 103.5}, {"text": "it", "start": 103.5, "end": 103.58}, {"text": "was", "start": 103.58, "end": 103.7}, {"text": "only", "start": 103.7, "end": 103.92}, {"text": "a", "start": 103.92, "end": 104.08}, {"text": "dramatic", "start": 104.08, "end": 104.4}, {"text": "zoom", "start": 104.4, "end": 104.7}, {"text": "on", "start": 104.7, "end": 104.88}, {"text": "the", "start": 104.88, "end": 105}]}, {"id": 42, "startTime": 105, "endTime": 107.5, "fullText": "part of whoever had made the recording he assumed.", "words": [{"text": "part", "start": 105, "end": 105.24}, {"text": "of", "start": 105.24, "end": 105.38}, {"text": "whoever", "start": 105.38, "end": 105.6}, {"text": "had", "start": 105.6, "end": 105.92}, {"text": "made", "start": 105.92, "end": 106.12}, {"text": "the", "start": 106.12, "end": 106.26}, {"text": "recording", "start": 106.26, "end": 106.62}, {"text": "he", "start": 106.14, "end": 106.84}, {"text": "assumed.", "start": 106.84, "end": 107.5}]}, {"id": 43, "startTime": 107.5, "endTime": 109.56, "fullText": "I speak of none other than the computer that", "words": [{"text": "I", "start": 107.5, "end": 107.86}, {"text": "speak", "start": 107.86, "end": 108.08}, {"text": "of", "start": 108.08, "end": 108.26}, {"text": "none", "start": 108.26, "end": 108.44}, {"text": "other", "start": 108.44, "end": 108.7}, {"text": "than", "start": 108.7, "end": 108.82}, {"text": "the", "start": 108.82, "end": 108.94}, {"text": "computer", "start": 108.94, "end": 109.26}, {"text": "that", "start": 109.26, "end": 109.56}]}, {"id": 44, "startTime": 109.56, "endTime": 111.92, "fullText": "is to come after me, in tone deep thought,", "words": [{"text": "is", "start": 109.56, "end": 109.68}, {"text": "to", "start": 109.68, "end": 109.82}, {"text": "come", "start": 109.82, "end": 109.96}, {"text": "after", "start": 109.96, "end": 110.22}, {"text": "me,", "start": 110.22, "end": 110.54}, {"text": "in", "start": 110.54, "end": 110.88}, {"text": "tone", "start": 110.88, "end": 111.04}, {"text": "deep", "start": 111.04, "end": 111.28}, {"text": "thought,", "start": 111.28, "end": 111.92}]}, {"id": 45, "startTime": 112.02, "endTime": 114.68, "fullText": "his voice regaining its accustomed declamatory tones.", "words": [{"text": "his", "start": 112.02, "end": 112.18}, {"text": "voice", "start": 112.18, "end": 112.42}, {"text": "regaining", "start": 112.42, "end": 112.94}, {"text": "its", "start": 112.94, "end": 113.16}, {"text": "accustomed", "start": 113.16, "end": 113.54}, {"text": "declamatory", "start": 113.54, "end": 114.24}, {"text": "tones.", "start": 114.24, "end": 114.68}]}, {"id": 46, "startTime": 114.68, "endTime": 118.3, "fullText": "A computer whose merest operational parameters I am not", "words": [{"text": "A", "start": 114.68, "end": 115.34}, {"text": "computer", "start": 115.34, "end": 115.66}, {"text": "whose", "start": 115.66, "end": 115.9}, {"text": "merest", "start": 115.9, "end": 116.38}, {"text": "operational", "start": 116.38, "end": 116.74}, {"text": "parameters", "start": 116.56, "end": 117.68}, {"text": "I", "start": 117.68, "end": 117.98}, {"text": "am", "start": 117.98, "end": 118.06}, {"text": "not", "start": 118.06, "end": 118.3}]}, {"id": 47, "startTime": 118.3, "endTime": 120.68, "fullText": "worthy to calculate, and yet I will design it", "words": [{"text": "worthy", "start": 118.3, "end": 118.56}, {"text": "to", "start": 118.56, "end": 118.76}, {"text": "calculate,", "start": 118.76, "end": 119.44}, {"text": "and", "start": 119.44, "end": 119.88}, {"text": "yet", "start": 119.88, "end": 119.98}, {"text": "I", "start": 119.98, "end": 120.1}, {"text": "will", "start": 120.1, "end": 120.2}, {"text": "design", "start": 120.2, "end": 120.5}, {"text": "it", "start": 120.5, "end": 120.68}]}, {"id": 48, "startTime": 120.68, "endTime": 123.44, "fullText": "for you. A computer which can calculate the question", "words": [{"text": "for", "start": 120.68, "end": 120.86}, {"text": "you.", "start": 120.86, "end": 121.06}, {"text": "A", "start": 121.06, "end": 121.62}, {"text": "computer", "start": 121.62, "end": 121.92}, {"text": "which", "start": 121.92, "end": 122.24}, {"text": "can", "start": 122.24, "end": 122.4}, {"text": "calculate", "start": 122.44, "end": 122.78}, {"text": "the", "start": 122.78, "end": 123.1}, {"text": "question", "start": 123.1, "end": 123.44}]}, {"id": 49, "startTime": 123.44, "endTime": 125.16, "fullText": "to the ultimate answer.", "words": [{"text": "to", "start": 123.44, "end": 123.6}, {"text": "the", "start": 123.6, "end": 123.74}, {"text": "ultimate", "start": 123.74, "end": 124.44}, {"text": "answer.", "start": 124.44, "end": 125.16}]}, {"id": 50, "startTime": 125.16, "endTime": 128.1, "fullText": "A computer of such infinite and subtle complexity that", "words": [{"text": "A", "start": 125.16, "end": 125.34}, {"text": "computer", "start": 125.34, "end": 125.62}, {"text": "of", "start": 125.62, "end": 125.88}, {"text": "such", "start": 125.88, "end": 126.1}, {"text": "infinite", "start": 126.1, "end": 126.54}, {"text": "and", "start": 126.54, "end": 126.86}, {"text": "subtle", "start": 126.86, "end": 127.16}, {"text": "complexity", "start": 127.16, "end": 127.7}, {"text": "that", "start": 127.26, "end": 128.1}]}, {"id": 51, "startTime": 128.1, "endTime": 131.18, "fullText": "organic life itself shall form part of its operational", "words": [{"text": "organic", "start": 128.1, "end": 128.56}, {"text": "life", "start": 128.56, "end": 128.94}, {"text": "itself", "start": 128.94, "end": 129.3}, {"text": "shall", "start": 129.3, "end": 129.66}, {"text": "form", "start": 129.66, "end": 130.06}, {"text": "part", "start": 130.06, "end": 130.34}, {"text": "of", "start": 130.34, "end": 130.48}, {"text": "its", "start": 130.48, "end": 130.6}, {"text": "operational", "start": 130.6, "end": 131.18}]}, {"id": 52, "startTime": 131.18, "endTime": 134.16, "fullText": "matrix. And you yourself shall take on new forms", "words": [{"text": "matrix.", "start": 131.18, "end": 132.02}, {"text": "And", "start": 132.02, "end": 132.48}, {"text": "you", "start": 132.48, "end": 132.6}, {"text": "yourself", "start": 132.6, "end": 132.88}, {"text": "shall", "start": 132.88, "end": 133.2}, {"text": "take", "start": 133.2, "end": 133.44}, {"text": "on", "start": 133.1, "end": 133.64}, {"text": "new", "start": 133.64, "end": 133.78}, {"text": "forms", "start": 133.78, "end": 134.16}]}, {"id": 53, "startTime": 134.16, "endTime": 136.48, "fullText": "and go down into the computer to navigate its", "words": [{"text": "and", "start": 134.16, "end": 134.42}, {"text": "go", "start": 134.42, "end": 134.58}, {"text": "down", "start": 134.58, "end": 134.86}, {"text": "into", "start": 134.86, "end": 135.08}, {"text": "the", "start": 135.08, "end": 135.22}, {"text": "computer", "start": 135.22, "end": 135.58}, {"text": "to", "start": 135.58, "end": 135.88}, {"text": "navigate", "start": 135.88, "end": 136.22}, {"text": "its", "start": 136.22, "end": 136.48}]}, {"id": 54, "startTime": 136.48, "endTime": 137.48, "fullText": "ten million year program.", "words": [{"text": "ten", "start": 136.48, "end": 136.66}, {"text": "million", "start": 136.66, "end": 136.9}, {"text": "year", "start": 136.9, "end": 137.12}, {"text": "program.", "start": 137.12, "end": 137.48}]}, {"id": 55, "startTime": 138.16, "endTime": 140.82, "fullText": "Yes, I shall design this computer for you.", "words": [{"text": "Yes,", "start": 138.16, "end": 138.58}, {"text": "I", "start": 138.58, "end": 139.12}, {"text": "shall", "start": 139.12, "end": 139.32}, {"text": "design", "start": 139.32, "end": 139.64}, {"text": "this", "start": 139.64, "end": 139.88}, {"text": "computer", "start": 139.88, "end": 140.18}, {"text": "for", "start": 140.18, "end": 140.5}, {"text": "you.", "start": 140.5, "end": 140.82}]}, {"id": 56, "startTime": 140.82, "endTime": 142.8, "fullText": "And I shall name it also unto you.", "words": [{"text": "And", "start": 140.82, "end": 141.28}, {"text": "I", "start": 141.28, "end": 141.38}, {"text": "shall", "start": 141.38, "end": 141.56}, {"text": "name", "start": 141.56, "end": 141.78}, {"text": "it", "start": 141.78, "end": 141.92}, {"text": "also", "start": 141.92, "end": 142.2}, {"text": "unto", "start": 142.2, "end": 142.48}, {"text": "you.", "start": 142.48, "end": 142.8}]}, {"id": 57, "startTime": 142.8, "endTime": 145.6, "fullText": "And it shall be called the earth.", "words": [{"text": "And", "start": 142.8, "end": 143.24}, {"text": "it", "start": 143.24, "end": 143.34}, {"text": "shall", "start": 143.34, "end": 143.48}, {"text": "be", "start": 143.48, "end": 143.62}, {"text": "called", "start": 143.62, "end": 143.92}, {"text": "the", "start": 143.6, "end": 145.04}, {"text": "earth.", "start": 145.04, "end": 145.6}]}, {"id": 58, "startTime": 145.6, "endTime": 147.22, "fullText": "Fouch gaped at deep thought.", "words": [{"text": "Fouch", "start": 145.6, "end": 146.06}, {"text": "gaped", "start": 146.06, "end": 146.36}, {"text": "at", "start": 146.36, "end": 146.5}, {"text": "deep", "start": 146.5, "end": 146.66}, {"text": "thought.", "start": 146.66, "end": 147.22}]}, {"id": 59, "startTime": 147.22, "endTime": 149.78, "fullText": "What a dull name, he said, and great incisions", "words": [{"text": "What", "start": 147.22, "end": 147.64}, {"text": "a", "start": 147.64, "end": 147.76}, {"text": "dull", "start": 147.76, "end": 147.92}, {"text": "name,", "start": 147.92, "end": 148.38}, {"text": "he", "start": 148.38, "end": 148.6}, {"text": "said,", "start": 148.6, "end": 148.92}, {"text": "and", "start": 148.92, "end": 149.02}, {"text": "great", "start": 149.02, "end": 149.28}, {"text": "incisions", "start": 149.28, "end": 149.78}]}, {"id": 60, "startTime": 149.78, "endTime": 152.04, "fullText": "appeared down the length of his body.", "words": [{"text": "appeared", "start": 149.78, "end": 150.16}, {"text": "down", "start": 150.2, "end": 150.42}, {"text": "the", "start": 150.42, "end": 150.62}, {"text": "length", "start": 150.62, "end": 150.88}, {"text": "of", "start": 150.88, "end": 151.04}, {"text": "his", "start": 151.04, "end": 151.18}, {"text": "body.", "start": 151.18, "end": 152.04}]}, {"id": 61, "startTime": 152.04, "endTime": 155.14, "fullText": "Loomqual too suddenly sustained horrific gash from nowhere.", "words": [{"text": "Loomqual", "start": 152.04, "end": 152.38}, {"text": "too", "start": 152.38, "end": 152.64}, {"text": "suddenly", "start": 152.64, "end": 153.08}, {"text": "sustained", "start": 153.08, "end": 153.58}, {"text": "horrific", "start": 153.58, "end": 153.98}, {"text": "gash", "start": 153.98, "end": 154.34}, {"text": "from", "start": 154.34, "end": 154.54}, {"text": "nowhere.", "start": 154.54, "end": 155.14}]}, {"id": 62, "startTime": 155.42, "endTime": 157.82, "fullText": "The computer console blotched and cracked.", "words": [{"text": "The", "start": 155.42, "end": 155.62}, {"text": "computer", "start": 155.62, "end": 155.94}, {"text": "console", "start": 155.94, "end": 156.44}, {"text": "blotched", "start": 156.44, "end": 156.92}, {"text": "and", "start": 156.92, "end": 157.2}, {"text": "cracked.", "start": 157.2, "end": 157.82}]}, {"id": 63, "startTime": 157.82, "endTime": 160.38, "fullText": "The walls flickered and crumbled and the room crashed", "words": [{"text": "The", "start": 157.82, "end": 158.14}, {"text": "walls", "start": 158.14, "end": 158.38}, {"text": "flickered", "start": 158.38, "end": 158.82}, {"text": "and", "start": 158.82, "end": 158.98}, {"text": "crumbled", "start": 158.98, "end": 159.32}, {"text": "and", "start": 159.32, "end": 159.64}, {"text": "the", "start": 159.64, "end": 159.76}, {"text": "room", "start": 159.76, "end": 159.96}, {"text": "crashed", "start": 159.58, "end": 160.38}]}, {"id": 64, "startTime": 160.38, "endTime": 162.2, "fullText": "upwards into its own ceiling.", "words": [{"text": "upwards", "start": 160.38, "end": 160.68}, {"text": "into", "start": 160.68, "end": 161}, {"text": "its", "start": 161, "end": 161.2}, {"text": "own", "start": 161.2, "end": 161.36}, {"text": "ceiling.", "start": 161.36, "end": 162.2}]}, {"id": 65, "startTime": 162.2, "endTime": 165.5, "fullText": "Slardabartfast was standing in front of Arthur holding the", "words": [{"text": "Slardabartfast", "start": 162.2, "end": 163.5}, {"text": "was", "start": 163.5, "end": 163.76}, {"text": "standing", "start": 163.76, "end": 164.06}, {"text": "in", "start": 164.06, "end": 164.3}, {"text": "front", "start": 164.3, "end": 164.54}, {"text": "of", "start": 164.54, "end": 164.7}, {"text": "Arthur", "start": 164.7, "end": 164.94}, {"text": "holding", "start": 164.94, "end": 165.28}, {"text": "the", "start": 165.28, "end": 165.5}]}, {"id": 66, "startTime": 165.5, "endTime": 168.64, "fullText": "two wires. End of the tape, he explained.", "words": [{"text": "two", "start": 165.5, "end": 165.7}, {"text": "wires.", "start": 165.26, "end": 166.6}, {"text": "End", "start": 166.6, "end": 166.88}, {"text": "of", "start": 166.88, "end": 166.94}, {"text": "the", "start": 166.94, "end": 167.08}, {"text": "tape,", "start": 167.08, "end": 167.56}, {"text": "he", "start": 167.56, "end": 167.68}, {"text": "explained.", "start": 167.68, "end": 168.64}]}], "primaryColor": "#111111", "mutedColor": "#c8c8c8", "backgroundColor": "#faf9f6", "fontFamily": "Playfair Display, Georgia, Garamond, serif", "mode": "cumulative"}