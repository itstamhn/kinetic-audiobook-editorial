the", "start": 172.92, "end": 173.06}, {"text": "story", "start": 173.06, "end": 173.3}, {"text": "of", "start": 173.3, "end": 173.52}, {"text": "its", "start": 173.52, "end": 173.64}, {"text": "extraordinary", "start": 173.64, "end": 174.16}, {"text": "consequences,", "start": 174.16, "end": 174.86}, {"text": "and", "start": 174.86, "end": 175.62}, {"text": "the", "start": 175.62, "end": 175.72}, {"text": "story", "start": 175.72, "end": 176.0}]}, {"id": 71, "startTime": 175.56, "endTime": 179.24, "fullText": "of how these consequences are inextricably intertwined with this", "words": [{"text": "of", "start": 175.56, "end": 176.24}, {"text": "how", "start": 176.24, "end": 176.36}, {"text": "these", "start": 176.36, "end": 176.56}, {"text": "consequences", "start": 176.56, "end": 177.12}, {"text": "are", "start": 177.12, "end": 177.54}, {"text": "inextricably", "start": 177.54, "end": 178.2}, {"text": "intertwined", "start": 178.2, "end": 178.9}, {"text": "with", "start": 178.9, "end": 179.06}, {"text": "this", "start": 179.06, "end": 179.24}]}, {"id": 72, "startTime": 179.24, "endTime": 181.44, "fullText": "remarkable book begins very simply.", "words": [{"text": "remarkable", "start": 179.24, "end": 179.72}, {"text": "book", "start": 179.72, "end": 180.06}, {"text": "begins", "start": 180.06, "end": 180.38}, {"text": "very", "start": 180.16, "end": 180.82}, {"text": "simply.", "start": 180.82, "end": 181.44}]}, {"id": 73, "startTime": 181.44, "endTime": 182.94, "fullText": "It begins with a house.", "words": [{"text": "It", "start": 181.44, "end": 181.88}, {"text": "begins", "start": 181.88, "end": 182.18}, {"text": "with", "start": 182.18, "end": 182.38}, {"text": "a", "start": 182.38, "end": 182.48}, {"text": "house.", "start": 182.48, "end": 182.94}]}], "primaryColor": "#111111", "mutedColor": "#c8c8c8", "backgroundColor": "#faf9f6", "fontFamily": "Playfair Display, Georgia, Garamond, serif", "mode": "cumulative"}