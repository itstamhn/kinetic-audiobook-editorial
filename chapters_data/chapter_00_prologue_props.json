 55.46}, {"text": "and", "start": 55.46, "end": 55.8}, {"text": "that", "start": 55.8, "end": 55.94}, {"text": "no", "start": 55.94, "end": 56.2}, {"text": "one", "start": 56.2, "end": 56.34}, {"text": "should", "start": 56.34, "end": 56.56}, {"text": "ever", "start": 56.56, "end": 56.78}]}, {"id": 24, "startTime": 56.78, "endTime": 57.72, "fullText": "have left the oceans.", "words": [{"text": "have", "start": 56.78, "end": 57.0}, {"text": "left", "start": 57.0, "end": 57.2}, {"text": "the", "start": 57.2, "end": 57.4}, {"text": "oceans.", "start": 57.14, "end": 57.72}]}, {"id": 25, "startTime": 57.72, "endTime": 61.64, "fullText": "And then, one Thursday, nearly 2,000 years after one", "words": [{"text": "And", "start": 57.72, "end": 58.54}, {"text": "then,", "start": 58.54, "end": 58.92}, {"text": "one", "start": 58.92, "end": 59.24}, {"text": "Thursday,", "start": 59.24, "end": 59.84}, {"text": "nearly", "start": 59.84, "end": 60.08}, {"text": "2,000", "start": 60.08, "end": 60.78}, {"text": "years", "start": 60.78, "end": 61.06}, {"text": "after", "start": 61.06, "end": 61.4}, {"text": "one", "start": 61.4, "end": 61.64}]}, {"id": 26, "startTime": 61.64, "endTime": 63.5, "fullText": "man had been nailed to a tree for saying", "words": [{"text": "man", "start": 61.64, "end": 61.9}, {"text": "had", "start": 61.9, "end": 62.04}, {"text": "been", "start": 62.04, "end": 62.14}, {"text": "nailed", "start": 62.14, "end": 62.4}, {"text": "to", "start": 62.4, "end": 62.6}, {"text": "a", "start": 62.6, "end": 62.72}, {"text": "tree", "start": 62.72, "end": 62.96}, {"text": "for", "start": 62.96, "end": 63.22}, {"text": "saying", "start": 63.22, "end": 63.5}]}, {"id": 27, "startTime": 63.06, "endTime": 65.08, "fullText": "how great it would be to be nice to", "words": [{"text": "how", "start": 63.06, "end": 63.76}, {"text": "great", "start": 63.76, "end": 64.06}, {"text": "it", "start": 64.06, "end": 64.22}, {"text": "would", "start": 64.22, "end": 64.34}, {"text": "be", 