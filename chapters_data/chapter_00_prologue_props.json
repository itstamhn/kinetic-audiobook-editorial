": 22.38, "fullText": "idea. idea. This planet has, or rather had,", "words": [{"text": "idea.", "start": 19.16, "end": 19.52}, {"text": "idea.", "start": 19.62, "end": 20.06}, {"text": "This", "start": 20.06, "end": 20.32}, {"text": "planet", "start": 20.32, "end": 20.64}, {"text": "has,", "start": 20.64, "end": 21.28}, {"text": "or", "start": 21.28, "end": 21.62}, {"text": "rather", "start": 21.62, "end": 21.84}, {"text": "had,", "start": 21.84, "end": 22.38}]}, {"id": 8, "startTime": 22.38, "endTime": 24.26, "fullText": "a problem, which was this.", "words": [{"text": "a", "start": 22.38, "end": 22.7}, {"text": "problem,", "start": 22.7, "end": 23.26}, {"text": "which", "start": 23.26, "end": 23.58}, {"text": "was", "start": 23.58, "end": 23.72}, {"text": "this.", "start": 23.72, "end": 24.26}]}, {"id": 9, "startTime": 24.26, "endTime": 26.38, "fullText": "Most of the people on it were unhappy for", "words": [{"text": "Most", "start": 24.26, "end": 24.76}, {"text": "of", "start": 24.76, "end": 24.88}, {"text": "the", "start": 24.88, "end": 25.0}, {"text": "people", "start": 25.0, "end": 25.24}, {"text": "on", "start": 25.24, "end": 25.48}, {"text": "it", "start": 25.48, "end": 25.54}, {"text": "were", "start": 25.54, "end": 25.66}, {"text": "unhappy", "start": 25.18, "end": 26.12}, {"text": "for", "start": 26.12, "end": 26.38}]}, {"id": 10, "startTime": 26.38, "endTime": 27.64, "fullText": "pretty much of the time.", "words": [{"text": "pretty", "start": 26.38, "end": 26.62}, {"text": "much", "start": 26.62, "end": 26.84}, {"text": "of", "start": 26.84, "end": 26.98}, {"text": "the", "start": 26.98, "end": 27.1}, {"text": "time.", "start": 27.1, "end": 27.64}]}, {"id": 11, "startTime": 27.64, "endTime": 30.16, "fullText": "Many solutions were suggested for this problem,", "words": [{"text": "Many", "start": 27.64, "end": 28.14}, {"text": "solutions", "start": 28.14, "end": 28.56}, {"text": "were", "start": 28.56, "end": 28.8}, {"text": "suggested", "start": 28.8,