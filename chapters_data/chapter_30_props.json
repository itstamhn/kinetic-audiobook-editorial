, "end": 8.182}, {"text": "a", "start": 8.182, "end": 8.302}, {"text": "paper", "start": 8.302, "end": 8.542}, {"text": "from", "start": 8.542, "end": 8.762}, {"text": "the", "start": 8.762, "end": 8.902}, {"text": "top", "start": 8.902, "end": 9.042}, {"text": "of", "start": 9.042, "end": 9.202}]}, {"id": 4, "startTime": 9.202, "endTime": 11.482, "fullText": "a pile, but then couldn't think of anywhere else", "words": [{"text": "a", "start": 9.202, "end": 9.322}, {"text": "pile,", "start": 9.322, "end": 9.742}, {"text": "but", "start": 9.742, "end": 10.042}, {"text": "then", "start": 10.042, "end": 10.182}, {"text": "couldn't", "start": 10.182, "end": 10.482}, {"text": "think", "start": 10.482, "end": 10.702}, {"text": "of", "start": 10.702, "end": 10.822}, {"text": "anywhere", "start": 10.822, "end": 11.182}, {"text": "else", "start": 11.182, "end": 11.482}]}, {"id": 5, "startTime": 11.482, "endTime": 13.542, "fullText": "to put it, so he butted back on top", "words": [{"text": "to", "start": 11.482, "end": 11.662}, {"text": "put", "start": 11.662, "end": 11.822}, {"text": "it,", "start": 11.822, "end": 12.062}, {"text": "so", "start": 12.322, "end": 12.522}, {"text": "he", "start": 12.522, "end": 12.682}, {"text": "butted", "start": 12.682, "end": 12.882}, {"text": "back", "start": 12.882, "end": 13.162}, {"text": "on", "start": 13.162, "end": 13.342}, {"text": "top", "start": 13.342, "end": 13.542}]}, {"id": 6, "startTime": 13.542, "endTime": 15.902, "fullText": "of the original pile which promptly fell over.", "words": [{"text": "of", "start": 13.542, "end": 13.702}, {"text": "the", "start": 13.702, "end": 13.802}, {"text": "original", "start": 13.802, "end": 14.182}, {"text": "pile", "start": 14.182, "end": 14.582}, {"text": "which", "start": 14.582, "end": 14.782}, {"text": "promptly", "start": 14.782, "end": 15.162}, {"text": "fell", "start": 15.162, "end": 15.462}, {"text": "over.", "start": 15.462, "end": 15.902}]}, {"id": 7, "startTime": 15.902, "endTime": 17.702, "fullText": "Deep thought designed the earth.", "words": [{"text": "Deep", "start": 15.902, "end": 16.462}, {"text": "thought", "start": 16.462, "end": 16.682}, {"text": "designed", "start": 16.682, "end": 17.062}, {"text": "the", "start": 16.622, "end": 17.282}, {"text": "earth.", "start": 17.282, "end": 17.702}]}, {"id": 8, "startTime": 17.702, "endTime": 19.762, "fullText": "We built it, and you lived on it.", "words": [{"text": "We", "start": 17.702, "end": 18.102}, {"text": "built", "start": 18.102, "end": 18.362}, {"text": "it,", "start": 18.362, "end": 18.602}, {"text": "and", "start": 18.602, "end": 18.902}, {"text": "you", "start": 18.902, "end": 19.042}, {"text": "lived", "start": 19.042, "end": 19.202}, {"text": "on", "start": 19.202, "end": 19.442}, {"text": "it.", "start": 19.442, "end": 19.762}]}, {"id": 9, "startTime": 19.762, "endTime": 22.502, "fullText": "And the Vogons came and destroyed it five minutes", "words": [{"text": "And", "start": 19.762, "end": 20.182}, {"text": "the", "start": 20.182, "end": 20.302}, {"text": "Vogons", "start": 20.302, "end": 20.722}, {"text": "came", "start": 20.722, "end": 21.102}, {"text": "and", "start": 21.102, "end": 21.382}, {"text": "destroyed", "start": 21.382, "end": 21.682}, {"text": "it", "start": 21.682, "end": 21.902}, {"text": "five", "start": 21.902, "end": 22.202}, {"text": "minutes", "start": 22.202, "end": 22.502}]}, {"id": 10, "startTime": 22.582, "endTime": 25.822, "fullText": "before the program was completed, added Arthur,", "words": [{"text": "before", "start": 22.582, "end": 22.862}, {"text": "the", "start": 22.862, "end": 23.102}, {"text": "program", "start": 23.102, "end": 23.462}, {"text": "was", "start": 23.462, "end": 23.802}, {"text": "completed,", "start": 23.802, "end": 24.582}, {"text": "added", "start": 24.722, "end": 25.002}, {"text": "Arthur,", "start": 25.002, "end": 25.822}]}, {"id": 11, "startTime": 25.822, "endTime": 28.702, "fullText": "not unbitterly. Yes, said the old man,", "words": [{"text": "not", "start": 25.822, "end": 25.942}, {"text": "unbitterly.", "start": 25.942, "end": 26.642}, {"text": "Yes,", "start": 26.982, "end": 27.522}, {"text": "said", "start": 27.522, "end": 27.842}, {"text": "the", "start": 27.842, "end": 27.982}, {"text": "old", "start": 27.982, "end": 28.202}, {"text": "man,", "start": 28.202, "end": 28.702}]}, {"id": 12, "startTime": 28.862, "endTime": 30.782, "fullText": "pausing to gaze hopelessly round the room.", "words": [{"text": "pausing", "start": 28.862, "end": 29.202}, {"text": "to", "start": 29.202, "end": 29.402}, {"text": "gaze", "start": 29.402, "end": 29.542}, {"text": "hopelessly", "start": 29.542, "end": 30.162}, {"text": "round", "start": 30.162, "end": 30.402}, {"text": "the", "start": 30.402, "end": 30.542}, {"text": "room.", "start": 30.542, "end": 30.782}]}, {"id": 13, "startTime": 31.242, "endTime": 33.522, "fullText": "Ten million years of planning and work gone just", "words": [{"text": "Ten", "start": 31.242, "end": 31.442}, {"text": "million", "start": 31.442, "end": 31.702}, {"text": "years", "start": 31.702, "end": 31.962}, {"text": "of", "start": 31.962, "end": 32.182}, {"text": "planning", "start": 32.182, "end": 32.502}, {"text": "and", "start": 32.062, "end": 32.762}, {"text": "work", "start": 32.762, "end": 33.062}, {"text": "gone", "start": 33.062, "end": 33.302}, {"text": "just", "start": 33.302, "end": 33.522}]}, {"id": 14, "startTime": 33.522, "endTime": 36.162, "fullText": "like that. Ten million years, Earth man.", "words": [{"text": "like", "start": 33.522, "end": 33.702}, {"text": "that.", "start": 33.702, "end": 34.062}, {"text": "Ten", "start": 34.442, "end": 34.622}, {"text": "million", "start": 34.622, "end": 34.882}, {"text": "years,", "start": 34.882, "end": 35.622}, {"text": "Earth", "start": 35.622, "end": 35.762}, {"text": "man.", "start": 35.762, "end": 36.162}]}, {"id": 15, "startTime": 36.902, "endTime": 38.442, "fullText": "Can you conceive of that kind of time span?", "words": [{"text": "Can", "start": 36.902, "end": 37.042}, {"text": "you", "start": 37.042, "end": 37.142}, {"text": "conceive", "start": 37.142, "end": 37.422}, {"text": "of", "start": 37.422, "end": 37.622}, {"text": "that", "start": 37.622, "end": 37.722}, {"text": "kind", "start": 37.722, "end": 37.882}, {"text": "of", "start": 37.882, "end": 37.982}, {"text": "time", "start": 37.982, "end": 38.222}, {"text": "span?", "start": 38.222, "end": 38.442}]}, {"id": 16, "startTime": 38.962, "endTime": 41.828, "fullText": "A galactic civilization could grow from a single worm", "words": [{"text": "A", "start": 38.962, "end": 39.162}, {"text": "galactic", "start": 39.048, "end": 39.448}, {"text": "civilization", "start": 39.448, "end": 39.908}, {"text": "could", "start": 39.628, "end": 40.508}, {"text": "grow", "start": 40.508, "end": 40.788}, {"text": "from", "start": 40.788, "end": 41.028}, {"text": "a", "start": 41.028, "end": 41.148}, {"text": "single", "start": 41.148, "end": 41.468}, {"text": "worm", "start": 41.468, "end": 41.828}]}, {"id": 17, "startTime": 41.828, "endTime": 43.908, "fullText": "five times over in that time.", "words": [{"text": "five", "start": 41.828, "end": 42.188}, {"text": "times", "start": 42.188, "end": 42.568}, {"text": "over", "start": 42.568, "end": 42.868}, {"text": "in", "start": 42.868, "end": 43.048}, {"text": "that", "start": 43.048, "end": 43.188}, {"text": "time.", "start": 43.188, "end": 43.908}]}, {"id": 18, "startTime": 43.908, "endTime": 47.348, "fullText": "Gone. He paused. Well, that's bureaucracy for you,", "words": [{"text": "Gone.", "start": 43.908, "end": 44.308}, {"text": "He", "start": 44.308, "end": 44.988}, {"text": "paused.", "start": 44.988, "end": 45.648}, {"text": "Well,", "start": 45.648, "end": 46.148}, {"text": "that's", "start": 46.148, "end": 46.288}, {"text": "bureaucracy", "start": 45.868, "end": 46.748}, {"text": "for", "start": 46.748, "end": 47.128}, {"text": "you,", "start": 47.128, "end": 47.348}]}, {"id": 19, "startTime": 47.348, "endTime": 50.088, "fullText": "he added. You know, said Arthur thoughtfully,", "words": [{"text": "he", "start": 47.348, "end": 47.468}, {"text": "added.", "start": 47.468, "end": 48.108}, {"text": "You", "start": 48.108, "end": 48.348}, {"text": "know,", "start": 48.348, "end": 48.748}, {"text": "said", "start": 48.748, "end": 49.088}, {"text": "Arthur", "start": 49.088, "end": 49.348}, {"text": "thoughtfully,", "start": 49.348, "end": 50.088}]}, {"id": 20, "startTime": 50.088, "endTime": 51.688, "fullText": "all this explains a lot of things.", "words": [{"text": "all", "start": 50.088, "end": 50.268}, {"text": "this", "start": 50.268, "end": 50.408}, {"text": "explains", "start": 50.408, "end": 50.768}, {"text": "a", "start": 50.768, "end": 50.988}, {"text": "lot", "start": 50.988, "end": 51.148}, {"text": "of", "start": 51.148, "end": 51.288}, {"text": "things.", "start": 51.288, "end": 51.688}]}, {"id": 21, "startTime": 52.248, "endTime": 54.148, "fullText": "All through my life, I've had this strange,", "words": [{"text": "All", "start": 52.248, "end": 52.408}, {"text": "through", "start": 52.408, "end": 52.568}, {"text": "my", "start": 52.568, "end": 52.708}, {"text": "life,", "start": 52.708, "end": 53.068}, {"text": "I've", "start": 53.068, "end": 53.228}, {"text": "had", "start": 53.228, "end": 53.368}, {"text": "this", "start": 53.368, "end": 53.548}, {"text": "strange,", "start": 53.548, "end": 54.148}]}, {"id": 22, "startTime": 54.148, "endTime": 56.388, "fullText": "unaccountable feeling that something was going on in the", "words": [{"text": "unaccountable", "start": 54.148, "end": 54.648}, {"text": "feeling", "start": 54.648, "end": 55.008}, {"text": "that", "start": 55.008, "end": 55.248}, {"text": "something", "start": 55.248, "end": 55.528}, {"text": "was", "start": 55.528, "end": 55.728}, {"text": "going", "start": 55.728, "end": 55.928}, {"text": "on", "start": 55.468, "end": 56.168}, {"text": "in", "start": 56.168, "end": 56.308}, {"text": "the", "start": 56.308, "end": 56.388}]}, {"id": 23, "startTime": 56.388, "endTime": 59.828, "fullText": "world, something big, even sinister, and no one would", "words": [{"text": "world,", "start": 56.388, "end": 57.008}, {"text": "something", "start": 57.008, "end": 57.348}, {"text": "big,", "start": 57.348, "end": 57.988}, {"text": "even", "start": 57.988, "end": 58.268}, {"text": "sinister,", "start": 58.268, "end": 58.948}, {"text": "and", "start": 58.948, "end": 59.328}, {"text": "no", "start": 59.328, "end": 59.508}, {"text": "one", "start": 59.508, "end": 59.668}, {"text": "would", "start": 59.668, "end": 59.828}]}, {"id": 24, "startTime": 59.828, "endTime": 60.708, "fullText": "tell me what it was.", "words": [{"text": "tell", "start": 59.828, "end": 59.988}, {"text": "me", "start": 59.988, "end": 60.128}, {"text": "what", "start": 60.128, "end": 60.308}, {"text": "it", "start": 60.308, "end": 60.408}, {"text": "was.", "start": 60.408, "end": 60.708}]}, {"id": 25, "startTime": 61.268, "endTime": 62.628, "fullText": "No, said the old man.", "words": [{"text": "No,", "start": 61.268, "end": 61.668}, {"text": "said", "start": 61.668, "end": 61.788}, {"text": "the", "start": 61.788, "end": 61.908}, {"text": "old", "start": 61.908, "end": 62.128}, {"text": "man.", "start": 62.128, "end": 62.628}]}, {"id": 26, "startTime": 62.628, "endTime": 64.868, "fullText": "That's just perfectly normal paranoia.", "words": [{"text": "That's", "start": 62.628, "end": 62.908}, {"text": "just", "start": 62.908, "end": 63.048}, {"text": "perfectly", "start": 63.048, "end": 63.468}, {"text": "normal", "start": 63.468, "end": 63.948}, {"text": "paranoia.", "start": 63.948, "end": 64.868}]}, {"id": 27, "startTime": 64.868, "endTime": 66.808, "fullText": "Everyone in the universe has that.", "words": [{"text": "Everyone", "start": 64.868, "end": 65.328}, {"text": "in", "start": 65.328, "end": 65.588}, {"text": "the", "start": 65.588, "end": 65.668}, {"text": "universe", "start": 65.668, "end": 65.948}, {"text": "has", "start": 65.948, "end": 66.328}, {"text": "that.", "start": 66.328, "end": 66.808}]}, {"id": 28, "startTime": 67.128, "endTime": 70.588, "fullText": "Everyone, said Arthur. Well, if everyone has that perhaps", "words": [{"text": "Everyone,", "start": 67.128, "end": 67.948}, {"text": "said", "start": 67.948, "end": 68.128}, {"text": "Arthur.", "start": 68.128, "end": 69.068}, {"text": "Well,", "start": 69.068, "end": 69.388}, {"text": "if", "start": 69.388, "end": 69.728}, {"text": "everyone", "start": 69.728, "end": 69.968}, {"text": "has", "start": 69.968, "end": 70.168}, {"text": "that", "start": 70.168, "end": 70.308}, {"text": "perhaps", "start": 70.308, "end": 70.588}]}, {"id": 29, "startTime": 70.588, "endTime": 73.608, "fullText": "it means something. Perhaps somewhere outside the universe we", "words": [{"text": "it", "start": 70.588, "end": 70.808}, {"text": "means", "start": 70.808, "end": 71.028}, {"text": "something.", "start": 71.028, "end": 71.608}, {"text": "Perhaps", "start": 71.868, "end": 72.128}, {"text": "somewhere", "start": 72.128, "end": 72.448}, {"text": "outside", "start": 72.448, "end": 72.768}, {"text": "the", "start": 72.768, "end": 73.048}, {"text": "universe", "start": 73.048, "end": 73.348}, {"text": "we", "start": 73.348, "end": 73.608}]}, {"id": 30, "startTime": 73.608, "endTime": 77.848, "fullText": "know. Maybe. Who cares, said Slardabartfast", "words": [{"text": "know.", "start": 73.608, "end": 74.188}, {"text": "Maybe.", "start": 74.188, "end": 75.088}, {"text": "Who", "start": 75.088, "end": 75.868}, {"text": "cares,", "start": 75.868, "end": 76.868}, {"text": "said", "start": 76.868, "end": 77.028}, {"text": "Slardabartfast", "start": 77.028, "end": 77.848}]}, {"id": 31, "startTime": 77.848, "endTime": 80.088, "fullText": "before Arthur got too excited.", "words": [{"text": "before", "start": 77.848, "end": 78.208}, {"text": "Arthur", "start": 77.808, "end": 78.668}, {"text": "got", "start": 78.668, "end": 78.948}, {"text": "too", "start": 78.948, "end": 79.168}, {"text": "excited.", "start": 79.168, "end": 80.088}]}, {"id": 32, "startTime": 80.088, "endTime": 82.108, "fullText": "Perhaps I'm old and tired, he continued.", "words": [{"text": "Perhaps", "start": 80.088, "end": 80.408}, {"text": "I'm", "start": 80.408, "end": 80.608}, {"text": "old", "start": 80.608, "end": 80.828}, {"text": "and", "start": 80.828, "end": 81.008}, {"text": "tired,", "start": 81.008, "end": 81.608}, {"text": "he", "start": 81.608, "end": 81.728}, {"text": "continued.", "start": 81.728, "end": 82.108}]}, {"id": 33, "startTime": 82.108, "endTime": 84.448, "fullText": "But I always think that the chances of finding", "words": [{"text": "But", "start": 82.108, "end": 82.728}, {"text": "I", "start": 82.728, "end": 82.808}, {"text": "always", "start": 82.808, "end": 83.108}, {"text": "think", "start": 83.108, "end": 83.348}, {"text": "that", "start": 83.348, "end": 83.508}, {"text": "the", "start": 83.008, "end": 83.648}, {"text": "chances", "start": 83.648, "end": 83.948}, {"text": "of", "start": 83.948, "end": 84.168}, {"text": "finding", "start": 84.168, "end": 84.448}]}, {"id": 34, "startTime": 84.448, "endTime": 86.648, "fullText": "out what really is going on are so absurdly", "words": [{"text": "out", "start": 84.448, "end": 84.708}, {"text": "what", "start": 84.708, "end": 84.868}, {"text": "really", "start": 84.868, "end": 85.168}, {"text": "is", "start": 85.168, "end": 85.348}, {"text": "going", "start": 85.348, "end": 85.528}, {"text": "on", "start": 85.528, "end": 85.768}, {"text": "are", "start": 85.768, "end": 85.868}, {"text": "so", "start": 85.868, "end": 86.088}, {"text": "absurdly", "start": 86.088, "end": 86.648}]}, {"id": 35, "startTime": 86.648, "endTime": 88.508, "fullText": "remote that the only thing to do is to", "words": [{"text": "remote", "start": 86.648, "end": 86.908}, {"text": "that", "start": 86.908, "end": 87.188}, {"text": "the", "start": 87.188, "end": 87.308}, {"text": "only", "start": 87.308, "end": 87.568}, {"text": "thing", "start": 87.568, "end": 87.828}, {"text": "to", "start": 87.828, "end": 87.988}, {"text": "do", "start": 87.988, "end": 88.208}, {"text": "is", "start": 88.248, "end": 88.388}, {"text": "to", "start": 88.388, "end": 88.508}]}, {"id": 36, "startTime": 88.508, "endTime": 90.328, "fullText": "say hang the sense of it and just keep", "words": [{"text": "say", "start": 88.508, "end": 88.688}, {"text": "hang", "start": 88.688, "end": 88.988}, {"text": "the", "start": 88.988, "end": 89.168}, {"text": "sense", "start": 89.168, "end": 89.388}, {"text": "of", "start": 89.388, "end": 89.548}, {"text": "it", "start": 89.548, "end": 89.648}, {"text": "and", "start": 89.648, "end": 89.908}, {"text": "just", "start": 89.908, "end": 90.108}, {"text": "keep", "start": 90.108, "end": 90.328}]}, {"id": 37, "startTime": 90.328, "endTime": 92.528, "fullText": "yourself occupied. Look at me.", "words": [{"text": "yourself", "start": 90.328, "end": 90.668}, {"text": "occupied.", "start": 90.668, "end": 91.248}, {"text": "Look", "start": 91.248, "end": 92.088}, {"text": "at", "start": 92.088, "end": 92.208}, {"text": "me.", "start": 92.208, "end": 92.528}]}, {"id": 38, "startTime": 92.528, "endTime": 95.468, "fullText": "I design coastlines. I got an award for Norway.", "words": [{"text": "I", "start": 92.528, "end": 92.848}, {"text": "design", "start": 92.848, "end": 93.148}, {"text": "coastlines.", "start": 93.148, "end": 94.008}, {"text": "I", "start": 94.328, "end": 94.468}, {"text": "got", "start": 94.468, "end": 94.628}, {"text": "an", "start": 94.628, "end": 94.728}, {"text": "award", "start": 94.728, "end": 94.988}, {"text": "for", "start": 94.988, "end": 95.208}, {"text": "Norway.", "start": 95.208, "end": 95.468}]}, {"id": 39, "startTime": 95.468, "endTime": 98.208, "fullText": "He rummaged around in a pile of debris and", "words": [{"text": "He", "start": 95.468, "end": 96.208}, {"text": "rummaged", "start": 96.208, "end": 96.528}, {"text": "around", "start": 96.528, "end": 96.828}, {"text": "in", "start": 96.828, "end": 97.008}, {"text": "a", "start": 97.008, "end": 97.068}, {"text": "pile", "start": 97.068, "end": 97.308}, {"text": "of", "start": 97.308, "end": 97.468}, {"text": "debris", "start": 97.468, "end": 97.748}, {"text": "and", "start": 97.748, "end": 98.208}]}, {"id": 40, "startTime": 98.208, "endTime": 100.588, "fullText": "pulled out a large perspex block with his name", "words": [{"text": "pulled", "start": 98.208, "end": 98.468}, {"text": "out", "start": 98.468, "end": 98.648}, {"text": "a", "start": 98.648, "end": 98.788}, {"text": "large", "start": 98.788, "end": 99.068}, {"text": "perspex", "start": 99.068, "end": 99.608}, {"text": "block", "start": 99.168, "end": 99.988}, {"text": "with", "start": 99.988, "end": 100.208}, {"text": "his", "start": 100.208, "end": 100.348}, {"text": "name", "start": 100.348, "end": 100.588}]}, {"id": 41, "startTime": 100.588, "endTime": 102.748, "fullText": "on it and a model of Norway molded into", "words": [{"text": "on", "start": 100.588, "end": 100.808}, {"text": "it", "start": 100.808, "end": 100.908}, {"text": "and", "start": 100.908, "end": 101.208}, {"text": "a", "start": 101.208, "end": 101.328}, {"text": "model", "start": 101.328, "end": 101.608}, {"text": "of", "start": 101.608, "end": 101.788}, {"text": "Norway", "start": 101.788, "end": 102.168}, {"text": "molded", "start": 102.168, "end": 102.528}, {"text": "into", "start": 102.528, "end": 102.748}]}, {"id": 42, "startTime": 102.748, "endTime": 104.168, "fullText": "it. Where's the sense in that?", "words": [{"text": "it.", "start": 102.748, "end": 102.928}, {"text": "Where's", "start": 102.928, "end": 103.568}, {"text": "the", "start": 103.568, "end": 103.708}, {"text": "sense", "start": 103.708, "end": 103.868}, {"text": "in", "start": 103.868, "end": 104.008}, {"text": "that?", "start": 104.008, "end": 104.168}]}, {"id": 43, "startTime": 104.168, "endTime": 106.768, "fullText": "He said, none that I've been able to make", "words": [{"text": "He", "start": 104.168, "end": 104.788}, {"text": "said,", "start": 104.788, "end": 105.368}, {"text": "none", "start": 105.648, "end": 105.828}, {"text": "that", "start": 105.828, "end": 105.988}, {"text": "I've", "start": 105.988, "end": 106.148}, {"text": "been", "start": 106.148, "end": 106.248}, {"text": "able", "start": 106.248, "end": 106.448}, {"text": "to", "start": 106.448, "end": 106.588}, {"text": "make", "start": 106.588, "end": 106.768}]}, {"id": 44, "startTime": 106.768, "endTime": 109.248, "fullText": "out. I've been doing fjords in all my life.", "words": [{"text": "out.", "start": 106.768, "end": 107.168}, {"text": "I've", "start": 107.168, "end": 107.608}, {"text": "been", "start": 107.608, "end": 107.728}, {"text": "doing", "start": 107.728, "end": 108.008}, {"text": "fjords", "start": 108.008, "end": 108.268}, {"text": "in", "start": 108.268, "end": 108.448}, {"text": "all", "start": 108.448, "end": 108.588}, {"text": "my", "start": 108.588, "end": 108.728}, {"text": "life.", "start": 108.728, "end": 109.248}]}, {"id": 45, "startTime": 109.248, "endTime": 112.028, "fullText": "For a fleeting moment they become fashionable and I", "words": [{"text": "For", "start": 109.248, "end": 109.768}, {"text": "a", "start": 109.768, "end": 109.888}, {"text": "fleeting", "start": 109.888, "end": 110.148}, {"text": "moment", "start": 110.148, "end": 110.488}, {"text": "they", "start": 110.028, "end": 110.708}, {"text": "become", "start": 110.708, "end": 111.008}, {"text": "fashionable", "start": 111.008, "end": 111.488}, {"text": "and", "start": 111.488, "end": 111.888}, {"text": "I", "start": 111.888, "end": 112.028}]}, {"id": 46, "startTime": 112.028, "endTime": 113.188, "fullText": "get a major award.", "words": [{"text": "get", "start": 112.028, "end": 112.188}, {"text": "a", "start": 112.188, "end": 112.308}, {"text": "major", "start": 112.308, "end": 112.588}, {"text": "award.", "start": 112.588, "end": 113.188}]}, {"id": 47, "startTime": 113.188, "endTime": 115.128, "fullText": "He turned it over in his hands with a", "words": [{"text": "He", "start": 113.188, "end": 113.608}, {"text": "turned", "start": 113.608, "end": 113.848}, {"text": "it", "start": 113.848, "end": 113.968}, {"text": "over", "start": 113.968, "end": 114.208}, {"text": "in", "start": 114.208, "end": 114.408}, {"text": "his", "start": 114.408, "end": 114.548}, {"text": "hands", "start": 114.548, "end": 114.848}, {"text": "with", "start": 114.848, "end": 114.988}, {"text": "a", "start": 114.988, "end": 115.128}]}, {"id": 48, "startTime": 115.128, "endTime": 118.088, "fullText": "shrug and tossed it aside carelessly, but not so", "words": [{"text": "shrug", "start": 115.128, "end": 115.468}, {"text": "and", "start": 115.468, "end": 115.768}, {"text": "tossed", "start": 115.828, "end": 116.028}, {"text": "it", "start": 116.028, "end": 116.228}, {"text": "aside", "start": 116.228, "end": 116.488}, {"text": "carelessly,", "start": 116.488, "end": 117.308}, {"text": "but", "start": 117.308, "end": 117.688}, {"text": "not", "start": 117.688, "end": 117.868}, {"text": "so", "start": 117.868, "end": 118.088}]}, {"id": 49, "startTime": 118.088, "endTime": 120.468, "fullText": "carelessly that it didn't land on something soft.", "words": [{"text": "carelessly", "start": 118.088, "end": 118.548}, {"text": "that", "start": 118.548, "end": 118.848}, {"text": "it", "start": 118.848, "end": 118.948}, {"text": "didn't", "start": 118.948, "end": 119.168}, {"text": "land", "start": 119.168, "end": 119.448}, {"text": "on", "start": 119.448, "end": 119.628}, {"text": "something", "start": 119.628, "end": 119.868}, {"text": "soft.", "start": 119.868, "end": 120.468}]}, {"id": 50, "startTime": 120.468, "endTime": 123.028, "fullText": "In this replacement earth we're building, they've given me", "words": [{"text": "In", "start": 120.468, "end": 120.928}, {"text": "this", "start": 120.928, "end": 121.068}, {"text": "replacement", "start": 120.808, "end": 121.628}, {"text": "earth", "start": 121.628, "end": 121.888}, {"text": "we're", "start": 121.888, "end": 122.068}, {"text": "building,", "start": 122.068, "end": 122.568}, {"text": "they've", "start": 122.568, "end": 122.708}, {"text": "given", "start": 122.708, "end": 122.868}, {"text": "me", "start": 122.868, "end": 123.028}]}, {"id": 51, "startTime": 123.028, "endTime": 125.068, "fullText": "Africa to do, and of course I'm doing it", "words": [{"text": "Africa", "start": 123.028, "end": 123.388}, {"text": "to", "start": 123.388, "end": 123.608}, {"text": "do,", "start": 123.608, "end": 124.008}, {"text": "and", "start": 124.008, "end": 124.148}, {"text": "of", "start": 124.148, "end": 124.268}, {"text": "course", "start": 124.268, "end": 124.488}, {"text": "I'm", "start": 124.488, "end": 124.668}, {"text": "doing", "start": 124.668, "end": 124.868}, {"text": "it", "start": 124.868, "end": 125.068}]}, {"id": 52, "startTime": 125.068, "endTime": 127.148, "fullText": "with all fjords again because I happen to like", "words": [{"text": "with", "start": 125.068, "end": 125.188}, {"text": "all", "start": 124.728, "end": 125.428}, {"text": "fjords", "start": 125.428, "end": 125.748}, {"text": "again", "start": 125.748, "end": 126.128}, {"text": "because", "start": 126.128, "end": 126.428}, {"text": "I", "start": 126.428, "end": 126.548}, {"text": "happen", "start": 126.548, "end": 126.788}, {"text": "to", "start": 126.788, "end": 126.928}, {"text": "like", "start": 126.928, "end": 127.148}]}, {"id": 53, "startTime": 127.148, "endTime": 129.528, "fullText": "them, and I'm old-fashioned enough to think that they", "words": [{"text": "them,", "start": 127.148, "end": 127.528}, {"text": "and", "start": 127.528, "end": 127.908}, {"text": "I'm", "start": 127.908, "end": 128.028}, {"text": "old-fashioned", "start": 128.028, "end": 128.568}, {"text": "enough", "start": 128.568, "end": 128.868}, {"text": "to", "start": 128.868, "end": 129.068}, {"text": "think", "start": 129.068, "end": 129.268}, {"text": "that", "start": 129.268, "end": 129.408}, {"text": "they", "start": 129.408, "end": 129.528}]}, {"id": 54, "startTime": 129.148, "endTime": 131.828, "fullText": "give a lovely baroque feel to a continent.", "words": [{"text": "give", "start": 129.148, "end": 129.648}, {"text": "a", "start": 129.648, "end": 129.768}, {"text": "lovely", "start": 129.768, "end": 130.128}, {"text": "baroque", "start": 130.128, "end": 130.528}, {"text": "feel", "start": 130.528, "end": 130.828}, {"text": "to", "start": 130.828, "end": 131.028}, {"text": "a", "start": 131.028, "end": 131.168}, {"text": "continent.", "start": 131.168, "end": 131.828}]}, {"id": 55, "startTime": 131.828, "endTime": 134.248, "fullText": "And they tell me it's not equatorial enough.", "words": [{"text": "And", "start": 131.828, "end": 132.288}, {"text": "they", "start": 132.288, "end": 132.368}, {"text": "tell", "start": 132.368, "end": 132.568}, {"text": "me", "start": 132.568, "end": 132.708}, {"text": "it's", "start": 132.708, "end": 132.868}, {"text": "not", "start": 132.868, "end": 133.068}, {"text": "equatorial", "start": 133.068, "end": 133.688}, {"text": "enough.", "start": 133.688, "end": 134.248}]}, {"id": 56, "startTime": 134.588, "endTime": 136.808, "fullText": "Equatorial? He gave a hollow laugh.", "words": [{"text": "Equatorial?", "start": 134.588, "end": 135.348}, {"text": "He", "start": 135.348, "end": 135.748}, {"text": "gave", "start": 135.748, "end": 135.908}, {"text": "a", "start": 135.908, "end": 136.048}, {"text": "hollow", "start": 136.048, "end": 136.228}, {"text": "laugh.", "start": 136.228, "end": 136.808}]}, {"id": 57, "startTime": 136.808, "endTime": 138.148, "fullText": "What does it matter?", "words": [{"text": "What", "start": 136.808, "end": 137.228}, {"text": "does", "start": 137.228, "end": 137.328}, {"text": "it", "start": 137.328, "end": 137.428}, {"text": "matter?", "start": 137.428, "end": 138.148}]}, {"id": 58, "startTime": 138.148, "endTime": 140.628, "fullText": "Science has achieved some wonderful things, of course,", "words": [{"text": "Science", "start": 138.148, "end": 138.568}, {"text": "has", "start": 138.568, "end": 138.808}, {"text": "achieved", "start": 138.808, "end": 139.068}, {"text": "some", "start": 139.068, "end": 139.288}, {"text": "wonderful", "start": 139.288, "end": 139.568}, {"text": "things,", "start": 139.128, "end": 140.108}, {"text": "of", "start": 140.108, "end": 140.148}, {"text": "course,", "start": 140.148, "end": 140.628}]}, {"id": 59, "startTime": 140.628, "endTime": 142.788, "fullText": "but I'd far rather be happy than write any", "words": [{"text": "but", "start": 140.628, "end": 140.928}, {"text": "I'd", "start": 140.928, "end": 141.068}, {"text": "far", "start": 141.068, "end": 141.308}, {"text": "rather", "start": 141.308, "end": 141.568}, {"text": "be", "start": 141.568, "end": 141.788}, {"text": "happy", "start": 141.788, "end": 142.108}, {"text": "than", "start": 142.108, "end": 142.328}, {"text": "write", "start": 142.328, "end": 142.568}, {"text": "any", "start": 142.568, "end": 142.788}]}, {"id": 60, "startTime": 142.788, "endTime": 144.168, "fullText": "day. And are you?", "words": [{"text": "day.", "start": 142.788, "end": 143.188}, {"text": "And", "start": 143.188, "end": 143.648}, {"text": "are", "start": 143.648, "end": 143.788}, {"text": "you?", "start": 143.788, "end": 144.168}]}, {"id": 61, "startTime": 144.168, "endTime": 146.528, "fullText": "No. That's where it all falls down,", "words": [{"text": "No.", "start": 144.168, "end": 144.648}, {"text": "That's", "start": 144.648, "end": 145.408}, {"text": "where", "start": 145.408, "end": 145.548}, {"text": "it", "start": 145.548, "end": 145.668}, {"text": "all", "start": 145.668, "end": 145.828}, {"text": "falls", "start": 145.828, "end": 146.148}, {"text": "down,", "start": 146.148, "end": 146.528}]}, {"id": 62, "startTime": 146.528, "endTime": 148.948, "fullText": "of course. Pity, said Arthur with sympathy.", "words": [{"text": "of", "start": 146.528, "end": 146.568}, {"text": "course.", "start": 146.568, "end": 147.268}, {"text": "Pity,", "start": 147.268, "end": 147.888}, {"text": "said", "start": 147.888, "end": 148.048}, {"text": "Arthur", "start": 148.048, "end": 148.348}, {"text": "with", "start": 148.348, "end": 148.568}, {"text": "sympathy.", "start": 148.568, "end": 148.948}]}, {"id": 63, "startTime": 148.948, "endTime": 151.968, "fullText": "It sounded like quite a good lifestyle otherwise.", "words": [{"text": "It", "start": 148.948, "end": 149.668}, {"text": "sounded", "start": 149.668, "end": 149.928}, {"text": "like", "start": 149.928, "end": 150.168}, {"text": "quite", "start": 150.168, "end": 150.388}, {"text": "a", "start": 150.388, "end": 150.528}, {"text": "good", "start": 150.528, "end": 150.628}, {"text": "lifestyle", "start": 150.188, "end": 151.108}, {"text": "otherwise.", "start": 151.108, "end": 151.968}]}, {"id": 64, "startTime": 151.968, "endTime": 154.548, "fullText": "Somewhere on the wall a small white light flashed.", "words": [{"text": "Somewhere", "start": 151.968, "end": 152.628}, {"text": "on", "start": 152.628, "end": 152.788}, {"text": "the", "start": 152.788, "end": 152.888}, {"text": "wall", "start": 152.888, "end": 153.088}, {"text": "a", "start": 153.088, "end": 153.228}, {"text": "small", "start": 153.228, "end": 153.488}, {"text": "white", "start": 153.488, "end": 153.788}, {"text": "light", "start": 153.788, "end": 154.028}, {"text": "flashed.", "start": 154.028, "end": 154.548}]}, {"id": 65, "startTime": 154.548, "endTime": 157.528, "fullText": "Come, said Slardabart Fast, you are to meet the", "words": [{"text": "Come,", "start": 154.548, "end": 155.408}, {"text": "said", "start": 155.408, "end": 155.728}, {"text": "Slardabart", "start": 155.728, "end": 156.228}, {"text": "Fast,", "start": 155.788, "end": 156.748}, {"text": "you", "start": 156.748, "end": 157.048}, {"text": "are", "start": 157.048, "end": 157.128}, {"text": "to", "start": 157.128, "end": 157.228}, {"text": "meet", "start": 157.228, "end": 157.368}, {"text": "the", "start": 157.368, "end": 157.528}]}, {"id": 66, "startTime": 157.528, "endTime": 160.648, "fullText": "mice. Your arrival on the planet has caused considerable", "words": [{"text": "mice.", "start": 157.528, "end": 158.048}, {"text": "Your", "start": 158.048, "end": 158.568}, {"text": "arrival", "start": 158.568, "end": 158.948}, {"text": "on", "start": 158.948, "end": 159.168}, {"text": "the", "start": 159.168, "end": 159.248}, {"text": "planet", "start": 159.248, "end": 159.508}, {"text": "has", "start": 159.508, "end": 159.788}, {"text": "caused", "start": 159.788, "end": 160.068}, {"text": "considerable", "start": 160.068, "end": 160.648}]}, {"id": 67, "startTime": 160.648, "endTime": 164.348, "fullText": "excitement. It has already been hailed, so I gather,", "words": [{"text": "excitement.", "start": 160.648, "end": 161.528}, {"text": "It", "start": 161.768, "end": 161.948}, {"text": "has", "start": 161.948, "end": 162.068}, {"text": "already", "start": 162.068, "end": 162.328}, {"text": "been", "start": 162.328, "end": 162.628}, {"text": "hailed,", "start": 162.628, "end": 163.248}, {"text": "so", "start": 163.248, "end": 163.488}, {"text": "I", "start": 163.488, "end": 163.608}, {"text": "gather,", "start": 163.608, "end": 164.348}]}, {"id": 68, "startTime": 164.348, "endTime": 166.728, "fullText": "as the third most improbable event in the history", "words": [{"text": "as", "start": 164.348, "end": 164.468}, {"text": "the", "start": 164.468, "end": 164.568}, {"text": "third", "start": 164.568, "end": 164.868}, {"text": "most", "start": 164.868, "end": 165.208}, {"text": "improbable", "start": 165.208, "end": 165.848}, {"text": "event", "start": 165.848, "end": 166.148}, {"text": "in", "start": 166.148, "end": 166.348}, {"text": "the", "start": 166.348, "end": 166.448}, {"text": "history", "start": 166.448, "end": 166.728}]}, {"id": 69, "startTime": 166.728, "endTime": 169.208, "fullText": "of the universe. What were the first two?", "words": [{"text": "of", "start": 166.728, "end": 166.968}, {"text": "the", "start": 166.968, "end": 167.068}, {"text": "universe.", "start": 166.588, "end": 167.368}, {"text": "What", "start": 167.368, "end": 168.248}, {"text": "were", "start": 168.248, "end": 168.348}, {"text": "the", "start": 168.348, "end": 168.468}, {"text": "first", "start": 168.468, "end": 168.708}, {"text": "two?", "start": 168.708, "end": 169.208}]}, {"id": 70, "startTime": 169.208, "endTime": 173.048, "fullText": "Oh, probably just coincidences, said Slardabart Fast carelessly.", "words": [{"text": "Oh,", "start": 169.208, "end": 169.868}, {"text": "probably", "start": 169.868, "end": 170.248}, {"text": "just", "start": 170.248, "end": 170.608}, {"text": "coincidences,", "start": 170.608, "end": 171.588}, {"text": "said", "start": 171.588, "end": 171.728}, {"text": "Slardabart", "start": 171.728, "end": 172.268}, {"text": "Fast", "start": 172.268, "end": 172.528}, {"text": "carelessly.", "start": 172.528, "end": 173.048}]}, {"id": 71, "startTime": 173.688, "endTime": 175.688, "fullText": "He opened the door and stood waiting for Arthur", "words": [{"text": "He", "start": 173.688, "end": 173.708}, {"text": "opened", "start": 173.708, "end": 174.028}, {"text": "the", "start": 174.028, "end": 174.168}, {"text": "door", "start": 174.168, "end": 174.388}, {"text": "and", "start": 174.388, "end": 174.648}, {"text": "stood", "start": 174.648, "end": 174.888}, {"text": "waiting", "start": 174.888, "end": 175.168}, {"text": "for", "start": 175.168, "end": 175.388}, {"text": "Arthur", "start": 175.388, "end": 175.688}]}, {"id": 72, "startTime": 175.688, "endTime": 178.628, "fullText": "to follow. Arthur glanced around him once more,", "words": [{"text": "to", "start": 175.688, "end": 175.928}, {"text": "follow.", "start": 175.928, "end": 176.528}, {"text": "Arthur", "start": 176.848, "end": 177.108}, {"text": "glanced", "start": 177.108, "end": 177.508}, {"text": "around", "start": 177.508, "end": 177.788}, {"text": "him", "start": 177.788, "end": 177.988}, {"text": "once", "start": 177.988, "end": 178.208}, {"text": "more,", "start": 178.208, "end": 178.628}]}, {"id": 73, "startTime": 178.628, "endTime": 180.988, "fullText": "and then down at himself, at the sweaty,", "words": [{"text": "and", "start": 178.628, "end": 178.988}, {"text": "then", "start": 178.988, "end": 179.128}, {"text": "down", "start": 179.128, "end": 179.408}, {"text": "at", "start": 179.408, "end": 179.548}, {"text": "himself,", "start": 179.548, "end": 180.128}, {"text": "at", "start": 180.128, "end": 180.428}, {"text": "the", "start": 180.428, "end": 180.528}, {"text": "sweaty,", "start": 180.528, "end": 180.988}]}, {"id": 74, "startTime": 180.988, "endTime": 183.088, "fullText": "disheveled clothes he had been lying in the mud", "words": [{"text": "disheveled", "start": 180.988, "end": 181.428}, {"text": "clothes", "start": 181.308, "end": 181.788}, {"text": "he", "start": 181.788, "end": 182.028}, {"text": "had", "start": 182.028, "end": 182.128}, {"text": "been", "start": 182.128, "end": 182.268}, {"text": "lying", "start": 182.268, "end": 182.588}, {"text": "in", "start": 182.588, "end": 182.788}, {"text": "the", "start": 182.788, "end": 182.888}, {"text": "mud", "start": 182.888, "end": 183.088}]}, {"id": 75, "startTime": 183.088, "endTime": 184.048, "fullText": "in on Thursday morning.", "words": [{"text": "in", "start": 183.088, "end": 183.228}, {"text": "on", "start": 183.228, "end": 183.348}, {"text": "Thursday", "start": 183.348, "end": 183.648}, {"text": "morning.", "start": 183.648, "end": 184.048}]}, {"id": 76, "startTime": 184.308, "endTime": 186.688, "fullText": "I seem to be having tremendous difficulty with my", "words": [{"text": "I", "start": 184.308, "end": 184.688}, {"text": "seem", "start": 184.688, "end": 184.888}, {"text": "to", "start": 184.888, "end": 185.008}, {"text": "be", "start": 185.008, "end": 185.088}, {"text": "having", "start": 185.088, "end": 185.308}, {"text": "tremendous", "start": 185.308, "end": 185.748}, {"text": "difficulty", "start": 185.748, "end": 186.168}, {"text": "with", "start": 186.168, "end": 186.528}, {"text": "my", "start": 186.528, "end": 186.688}]}, {"id": 77, "startTime": 186.688, "endTime": 188.428, "fullText": "lifestyle, he muttered to himself.", "words": [{"text": "lifestyle,", "start": 186.688, "end": 187.448}, {"text": "he", "start": 187.448, "end": 187.688}, {"text": "muttered", "start": 187.688, "end": 187.888}, {"text": "to", "start": 187.888, "end": 188.048}, {"text": "himself.", "start": 188.048, "end": 188.428}]}, {"id": 78, "startTime": 188.988, "endTime": 191.488, "fullText": "I beg your pardon, said the old man mildly.", "words": [{"text": "I", "start": 188.988, "end": 189.108}, {"text": "beg", "start": 189.108, "end": 189.268}, {"text": "your", "start": 189.268, "end": 189.388}, {"text": "pardon,", "start": 189.388, "end": 189.848}, {"text": "said", "start": 189.848, "end": 190.348}, {"text": "the", "start": 190.348, "end": 190.468}, {"text": "old", "start": 190.468, "end": 190.648}, {"text": "man", "start": 190.648, "end": 190.888}, {"text": "mildly.", "start": 190.888, "end": 191.488}]}, {"id": 79, "startTime": 191.828, "endTime": 194.028, "fullText": "Oh nothing, said Arthur, only joking.", "words": [{"text": "Oh", "start": 191.828, "end": 191.968}, {"text": "nothing,", "start": 191.968, "end": 192.568}, {"text": "said", "start": 192.568, "end": 192.728}, {"text": "Arthur,", "start": 192.728, "end": 193.528}, {"text": "only", "start": 193.528, "end": 193.688}, {"text": "joking.", "start": 193.688, "end": 194.028}]}, {"id": 80, "startTime": 194.628, "endTime": 194.768, "fullText": "It", "words": [{"text": "It", "start": 194.628, "end": 194.768}]}], "primaryColor": "#111111", "mutedColor": "#c8c8c8", "backgroundColor": "#faf9f6", "fontFamily": "Playfair Display, Georgia, Garamond, serif", "mode": "cumulative"}