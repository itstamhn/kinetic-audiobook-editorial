a", "start": 163.77, "end": 163.89}, {"text": "note", "start": 163.89, "end": 164.09}, {"text": "from", "start": 164.09, "end": 164.31}, {"text": "him", "start": 164.31, "end": 164.49}]}, {"id": 65, "startTime": 164.49, "endTime": 166.69, "fullText": "pinned to part of its sparse instrument panel.", "words": [{"text": "pinned", "start": 164.49, "end": 164.65}, {"text": "to", "start": 164.21, "end": 164.89}, {"text": "part", "start": 164.89, "end": 165.07}, {"text": "of", "start": 165.07, "end": 165.21}, {"text": "its", "start": 165.21, "end": 165.33}, {"text": "sparse", "start": 165.33, "end": 165.67}, {"text": "instrument", "start": 165.67, "end": 166.05}, {"text": "panel.", "start": 166.05, "end": 166.69}]}, {"id": 66, "startTime": 166.69, "endTime": 168.75, "fullText": "The note had an arrow drawn on it,", "words": [{"text": "The", "start": 166.69, "end": 167.11}, {"text": "note", "start": 167.11, "end": 167.25}, {"text": "had", "start": 167.25, "end": 167.45}, {"text": "an", "start": 167.45, "end": 167.59}, {"text": "arrow", "start": 167.59, "end": 167.81}, {"text": "drawn", "start": 167.81, "end": 168.13}, {"text": "on", "start": 168.13, "end": 168.37}, {"text": "it,", "start": 168.37, "end": 168.75}]}, {"id": 67, "startTime": 168.75, "endTime": 170.47, "fullText": "pointing at one of the controls.", "words": [{"text": "pointing", "start": 168.75, "end": 169.09}, {"text": "at", "start": 169.09, "end": 169.33}, {"text": "one", "start": 169.33, "end": 169.43}, {"text": "of", "start": 169.43, "end": 169.51}, {"text": "the", "start": 169.51, "end": 169.61}, {"text": "controls.", "start": 169.15, "end": 170.47}]}, {"id": 68, "startTime": 170.47, "endTime": 173.15, "fullText": "It said, this is probably the best button to", "words": [{"text": "It", "start": 170.47, "end": 170.81}, {"text": "said,", "start": 170.81, "end": 171.25}, {"text": "this", "start": 171.25, "end": 171.59}, {"text": "is", "start": 171.59, "end": 171.71}, {"text": "probably", "start": 171.71, "e