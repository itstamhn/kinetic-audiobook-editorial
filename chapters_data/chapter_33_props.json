": 113.75, "end": 114.09}]}, {"id": 46, "startTime": 114.09, "endTime": 115.93, "fullText": "of the main computer back on the ship,", "words": [{"text": "of", "start": 114.09, "end": 114.35}, {"text": "the", "start": 114.35, "end": 114.47}, {"text": "main", "start": 114.47, "end": 114.67}, {"text": "computer", "start": 114.67, "end": 115.15}, {"text": "back", "start": 115.15, "end": 115.41}, {"text": "on", "start": 115.41, "end": 115.59}, {"text": "the", "start": 115.59, "end": 115.71}, {"text": "ship,", "start": 115.71, "end": 115.93}]}, {"id": 47, "startTime": 115.93, "endTime": 118.53, "fullText": "with which they were directly linked through the sub-Etha.", "words": [{"text": "with", "start": 115.93, "end": 116.47}, {"text": "which", "start": 116.47, "end": 116.63}, {"text": "they", "start": 116.63, "end": 116.77}, {"text": "were", "start": 116.77, "end": 116.87}, {"text": "directly", "start": 116.87, "end": 117.27}, {"text": "linked", "start": 116.81, "end": 117.63}, {"text": "through", "start": 117.63, "end": 117.81}, {"text": "the", "start": 117.81, "end": 117.95}, {"text": "sub-Etha.", "start": 117.95, "end": 118.53}]}, {"id": 48, "startTime": 118.53, "endTime": 121.71, "fullText": "Such a system was fail-safe in all circumstances other", "words": [{"text": "Such", "start": 118.53, "end": 119.05}, {"text": "a", "start": 119.05, "end": 119.19}, {"text": "system", "start": 119.19, "end": 119.45}, {"text": "was", "start": 119.45, "end": 119.69}, {"text": "fail-safe", "start": 119.69, "end": 120.25}, {"text": "in", "start": 120.25, "end": 120.43}, {"text": "all", "start": 120.43, "end": 120.61}, {"text": "circumstances", "start": 120.61, "end": 121.19}, {"text": "other", "start": 121.19, "end": 121.71}]}, {"id": 49, "startTime": 121.71, "endTime": 124.83, "fullText": "than total feedback malfunction, which was unheard of.", "words": [{"text": "than", "start": 121.71, "end": 121.95}, {"text": "total", "start": 121.95, "end": 122.27}, {"text": "feedback", "start": 122.33, "end": 122.75}, {"text": "malfunction,", "start": 122.75, "end": 123.69}, {"text": "which", "start": 123.69, "end": 123.97}, {"text": "was", "start": 123.97, "end": 124.13}, {"text": "unheard", "start": 124.13, "end": 124.39}, {"text": "of.", "start": 124.39, "end": 124.83}]}, {"id": 50, "startTime": 124.83, "endTime": 127.29, "fullText": "He hurried over to the other prone figure and", "words": [{"text": "He", "start": 124.83, "end": 125.21}, {"text": "hurried", "start": 125.21, "end": 125.47}, {"text": "over", "start": 125.47, "end": 125.69}, {"text": "to", "start": 125.69, "end": 125.87}, {"text": "the", "start": 125.87, "end": 125.99}, {"text": "other", "start": 125.99, "end": 126.23}, {"text": "prone", "start": 126.23, "end": 126.47}, {"text": "figure", "start": 126.47, "end": 126.81}, {"text": "and", "start": 126.81, "end": 127.29}]}, {"id": 51, "startTime": 127.21, "endTime": 130.45, "fullText": "discovered that exactly the same impossible thing had happened", "words": [{"text": "discovered", "start": 127.21, "end": 127.75}, {"text": "that", "start": 127.75, "end": 127.95}, {"text": "exactly", "start": 127.95, "end": 128.41}, {"text": "the", "start": 128.41, "end": 128.67}, {"text": "same", "start": 128.67, "end": 128.97}, {"text": "impossible", "start": 128.97, "end": 129.51}, {"text": "thing", "start": 129.51, "end": 129.93}, {"text": "had", "start": 129.93, "end": 130.13}, {"text": "happened", "start": 130.13, "end": 130.45}]}, {"id": 52, "startTime": 130.45, "endTime": 132.25, "fullText": "to him, presumably simultaneously.", "words": [{"text": "to", "start": 130.45, "end": 130.61}, {"text": "him,", "start": 130.61, "end": 130.97}, {"text": "presumably", "start": 130.97, "end": 131.47}, {"text": "simultaneously.", "start": 131.47, "end": 132.25}]}, {"id": 53, "startTime": 133.13, "endTime": 134.71, "fullText": "He called the others over to look.", "words": [{"text": "He", "start": 133.13, "end": 133.29}, {"text": "called", "start": 133.29, "end": 133.51}, {"text": "the", "start": 133.51, "end": 133.65}, {"text": "others", "start": 133.65, "end": 133.91}, {"text": "over", "start": 133.91, "end": 134.17}, {"text": "to", "start": 134.17, "end": 134.27}, {"text": "look.", "start": 134.27, "end": 134.71}]}, {"id": 54, "startTime": 134.71, "endTime": 138.17, "fullText": "They came, shared his astonishment, but not his curiosity.", "words": [{"text": "They", "start": 134.71, "end": 135.15}, {"text": "came,", "start": 135.15, "end": 135.79}, {"text": "shared", "start": 135.79, "end": 136.07}, {"text": "his", "start": 136.07, "end": 136.21}, {"text": "astonishment,", "start": 136.21, "end": 136.99}, {"text": "but", "start": 136.99, "end": 137.35}, {"text": "not", "start": 137.35, "end": 137.55}, {"text": "his", "start": 137.55, "end": 137.71}, {"text": "curiosity.", "start": 137.71, "end": 138.17}]}, {"id": 55, "startTime": 138.87, "endTime": 140.41, "fullText": "Let's get shot out of this hole,", "words": [{"text": "Let's", "start": 138.87, "end": 139.11}, {"text": "get", "start": 139.11, "end": 139.25}, {"text": "shot", "start": 139.25, "end": 139.51}, {"text": "out", "start": 139.51, "end": 139.67}, {"text": "of", "start": 139.67, "end": 139.73}, {"text": "this", "start": 139.73, "end": 139.91}, {"text": "hole,", "start": 139.91, "end": 140.41}]}, {"id": 56, "startTime": 140.41, "endTime": 142.95, "fullText": "said Zaphod. If whatever I'm supposed to be looking", "words": [{"text": "said", "start": 140.41, "end": 140.57}, {"text": "Zaphod.", "start": 140.57, "end": 141.23}, {"text": "If", "start": 141.23, "end": 141.71}, {"text": "whatever", "start": 141.71, "end": 141.91}, {"text": "I'm", "start": 141.91, "end": 142.11}, {"text": "supposed", "start": 142.11, "end": 142.39}, {"text": "to", "start": 142.39, "end": 142.61}, {"text": "be", "start": 142.61, "end": 142.73}, {"text": "looking", "start": 142.73, "end": 142.95}]}, {"id": 57, "startTime": 142.95, "endTime": 144.85, "fullText": "for is here, I don't want it.", "words": [{"text": "for", "start": 142.95, "end": 143.25}, {"text": "is", "start": 143.25, "end": 143.45}, {"text": "here,", "start": 143.45, "end": 143.85}, {"text": "I", "start": 143.21, "end": 144.23}, {"text": "don't", "start": 144.23, "end": 144.41}, {"text": "want", "start": 144.41, "end": 144.59}, {"text": "it.", "start": 144.59, "end": 144.85}]}, {"id": 58, "startTime": 144.85, "endTime": 148.33, "fullText": "He grabbed the second KiloZap gun, blasted a perfectly", "words": [{"text": "He", "start": 144.85, "end": 145.33}, {"text": "grabbed", "start": 145.33, "end": 145.59}, {"text": "the", "start": 145.59, "end": 145.77}, {"text": "second", "start": 145.77, "end": 146.11}, {"text": "KiloZap", "start": 146.11, "end": 146.65}, {"text": "gun,", "start": 146.65, "end": 147.39}, {"text": "blasted", "start": 147.39, "end": 147.81}, {"text": "a", "start": 147.81, "end": 147.91}, {"text": "perfectly", "start": 147.91, "end": 148.33}]}, {"id": 59, "startTime": 148.33, "endTime": 152.23, "fullText": "harmless accounting computer and rushed out into the corridor,", "words": [{"text": "harmless", "start": 148.33, "end": 148.87}, {"text": "accounting", "start": 148.87, "end": 149.37}, {"text": "computer", "start": 149.43, "end": 149.83}, {"text": "and", "start": 149.83, "end": 150.29}, {"text": "rushed", "start": 150.29, "end": 150.57}, {"text": "out", "start": 150.57, "end": 150.79}, {"text": "into", "start": 150.79, "end": 151.01}, {"text": "the", "start": 151.01, "end": 151.13}, {"text": "corridor,", "start": 151.13, "end": 152.23}]}, {"id": 60, "startTime": 152.23, "endTime": 153.37, "fullText": "followed by the others.", "words": [{"text": "followed", "start": 152.23, "end": 152.37}, {"text": "by", "start": 152.37, "end": 152.61}, {"text": "the", "start": 152.61, "end": 152.75}, {"text": "others.", "start": 152.75, "end": 153.37}]}, {"id": 61, "startTime": 153.37, "endTime": 156.01, "fullText": "He very nearly blasted hell out of an aircar", "words": [{"text": 